--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -83,3 +83,9 @@
 add_library(${PROJECT_NAME})
 
+# BCC64X uses the lib prefix for DLL targets unless explicitly suppressed.
+# Preserve the upstream DirectXMesh DLL/import-library package names.
+if(WIN32 AND BUILD_SHARED_LIBS AND DEFINED ENV{CB_BCC64X})
+  set_target_properties(${PROJECT_NAME} PROPERTIES PREFIX "")
+endif()
 target_sources(${PROJECT_NAME} PRIVATE ${LIBRARY_HEADERS} ${LIBRARY_SOURCES})
@@ -251,2 +257,8 @@
   target_link_libraries(meshconvert PRIVATE ${PROJECT_NAME} version.lib)
+  # meshconvert implements wmain; use the Unicode CRT startup with BCC64X.
+  # Keep the original command-line tool and all its source files enabled.
+  if(DEFINED ENV{CB_BCC64X} AND NOT "$ENV{CB_BCC64X}" STREQUAL "")
+    target_link_options(meshconvert PRIVATE -municode)
+  endif()
+
   source_group(meshconvert REGULAR_EXPRESSION meshconvert/*.*)
