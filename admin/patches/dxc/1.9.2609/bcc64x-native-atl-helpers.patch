 #include "dxc/WinAdapter.h"
+#if defined(_WIN32) && defined(__clang__) && !defined(_MSC_VER)
+// Native COM ABI; DXC requires only a small subset of ATL helper wrappers.
+#include "dxc/Support/Bcc64xNativeAtl.h"
