+  if (CMAKE_BUILD_TYPE STREQUAL "Debug" AND
+      (name STREQUAL "harfbuzz" OR name STREQUAL "harfbuzz-subset"))
+    string(REPLACE "-l${name}" "-l${name}d" FSTR "${FSTR}")
+  endif ()
 
   file(WRITE "${PROJECT_BINARY_DIR}/${name}.pc" ${FSTR})
 
