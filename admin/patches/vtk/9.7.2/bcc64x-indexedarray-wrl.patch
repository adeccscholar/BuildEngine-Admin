-vtk_module_add_module(VTK::RenderingOpenGL2
-  CLASSES ${classes}
-  PRIVATE_CLASSES ${private_classes}
-  SOURCES ${sources} ${vtk_object_factory_source} ${private_sources}
-  HEADERS ${headers}
