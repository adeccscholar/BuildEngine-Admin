diff --git a/src/gpu/ganesh/gl/win/GrGLMakeWinInterface.cpp b/src/gpu/ganesh/gl/win/GrGLMakeWinInterface.cpp
--- a/src/gpu/ganesh/gl/win/GrGLMakeWinInterface.cpp
+++ b/src/gpu/ganesh/gl/win/GrGLMakeWinInterface.cpp
@@ -20,8 +20,14 @@ sk_sp<const GrGLInterface> MakeWin() {
     }
 
     struct FreeModule { void operator()(HMODULE m) { (void)FreeLibrary(m); } };
+#if defined(__BORLANDC__) && defined(__clang__)
+    // Use the application-local OpenGL runtime supplied by the BuildEngine package.
+    std::unique_ptr<typename std::remove_pointer<HMODULE>::type, FreeModule> module(
+            LoadLibraryA("opengl32.dll"));
+#else
     std::unique_ptr<typename std::remove_pointer<HMODULE>::type, FreeModule> module(
             LoadLibraryExA("opengl32.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32));
+#endif
     if (!module) {
         return nullptr;
     }
