+static inline D3D12_RESOURCE_DESC GrD3DGetResourceDesc(ID3D12Resource* resource) {
+#if defined(__BORLANDC__) && defined(__clang__)
+    D3D12_RESOURCE_DESC desc = {};
+    resource->GetDesc(&desc);
+    return desc;
+#else
+    return resource->GetDesc();
+#endif
+}
+
+static inline D3D12_DESCRIPTOR_HEAP_DESC GrD3DGetDescriptorHeapDesc(
+        ID3D12DescriptorHeap* heap) {
+#if defined(__BORLANDC__) && defined(__clang__)
+    D3D12_DESCRIPTOR_HEAP_DESC desc = {};
+    heap->GetDesc(&desc);
+    return desc;
+#else
+    return heap->GetDesc();
+#endif
+}
+
+static inline D3D12_CPU_DESCRIPTOR_HANDLE GrD3DGetCPUDescriptorHandleForHeapStart(
+        ID3D12DescriptorHeap* heap) {
+#if defined(__BORLANDC__) && defined(__clang__)
+    D3D12_CPU_DESCRIPTOR_HANDLE handle = {};
+    heap->GetCPUDescriptorHandleForHeapStart(&handle);
+    return handle;
+#else
+    return heap->GetCPUDescriptorHandleForHeapStart();
+#endif
+}
+
+static inline D3D12_GPU_DESCRIPTOR_HANDLE GrD3DGetGPUDescriptorHandleForHeapStart(
+        ID3D12DescriptorHeap* heap) {
+#if defined(__BORLANDC__) && defined(__clang__)
+    D3D12_GPU_DESCRIPTOR_HANDLE handle = {};
+    heap->GetGPUDescriptorHandleForHeapStart(&handle);
+    return handle;
+#else
+    return heap->GetGPUDescriptorHandleForHeapStart();
+#endif
+}
