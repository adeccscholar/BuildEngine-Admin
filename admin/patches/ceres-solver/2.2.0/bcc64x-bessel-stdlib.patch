+inline double BesselJ0(double x) {
+#if defined(_WIN32)
+  return _j0(x);
+#else
+  CERES_DISABLE_DEPRECATED_WARNING
+  return j0(x);
+  CERES_RESTORE_DEPRECATED_WARNING
+#endif
+}
+inline double BesselJ1(double x) {
+#if defined(_WIN32)
+  return _j1(x);
+#else
