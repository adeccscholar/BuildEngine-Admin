# BuildEngine GN adapter for the installed ICU 78.3 package.
# The package is supplied by BuildEngine; no ICU sources are rebuilt here.
config("installed_icu") {
  include_dirs = [ getenv("CB_PDFIUM_ICU_INCLUDE") ]
  libs = [ getenv("CB_PDFIUM_ICU_LIB") ]
}
group("icuuc") {
  public_configs = [ ":installed_icu" ]
}
