# BuildEngine GN bridge for installed Abseil 20260817.0.
# Resolve the monolithic import library through BCC64X/LLD's native -l search.
# The versioned package directory is supplied by the BuildEngine dependency.
# Do not call GN path_exists() on external absolute Windows paths: the pinned
# GN binary terminates during path processing on this profile.
_absl_include = getenv("CB_PDFIUM_ABSEIL_INCLUDE")
_absl_libdir = getenv("CB_PDFIUM_ABSEIL_LIBDIR")
assert(_absl_include != "" && _absl_libdir != "",
       "Installed Abseil include directory and library directory are required")

config("installed_abseil") {
  include_dirs = [ _absl_include ]
  lib_dirs = [ _absl_libdir ]
  libs = [ "abseil_dll" ]
  defines = [ "ABSL_CONSUME_DLL" ]
}

group("absl") {
  public_configs = [ ":installed_abseil" ]
}
