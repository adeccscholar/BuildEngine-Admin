@@ -5,7 +5,25 @@
   find_package(DiaSDK REQUIRED) # Used for constants and declarations.
 endif (MSVC)
 
+if (WIN32 AND ADECC_BCC64X_NATIVE_X64 AND NOT MSVC)
+  # This native Windows compiler uses the original DIA and PIX sources.
+  # Require the genuine DIA SDK declarations; do not drop original features.
+  find_path(ADECC_DXC_DIA_INCLUDE_DIR dia2.h
+    HINTS
+      "$ENV{VSINSTALLDIR}/DIA SDK/include"
+      "$ENV{MSVC_DIA_SDK_DIR}/include"
+      "$ENV{DIA_SDK_DIR}/include"
+      "C:/Program Files/Microsoft Visual Studio/2022/Professional/DIA SDK/include"
+      "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/DIA SDK/include"
+      "C:/Program Files/Microsoft Visual Studio/2022/Community/DIA SDK/include"
+      "C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/DIA SDK/include")
+  if(NOT ADECC_DXC_DIA_INCLUDE_DIR)
+    message(FATAL_ERROR "DXC native DIA requires Microsoft DIA SDK dia2.h")
+  endif()
+  set(DIASDK_INCLUDE_DIRS "${ADECC_DXC_DIA_INCLUDE_DIR}")
+endif()
+
+if (MSVC OR (WIN32 AND ADECC_BCC64X_NATIVE_X64))
