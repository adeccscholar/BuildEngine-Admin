--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -84,7 +84,82 @@
             "${CMAKE_CURRENT_BINARY_DIR}/cppwinrt/winrt/base.h"
     )
 endif()
 include_directories("${CPPWINRT_PROJECTION_INCLUDE_DIR}")
+# BuildEngine: generate the original test_component projection from its IDL,
+# instead of silently excluding the upstream test that consumes it.
+if(WIN32 AND NOT STANDALONE_TESTING)
+    # These are managed dependencies, never searched in Windows Kits or PATH.
+    if(NOT DEFINED ADECC_CPPWINRT_MIDLRT OR
+       NOT EXISTS "${ADECC_CPPWINRT_MIDLRT}")
+        message(FATAL_ERROR "C++/WinRT tests require explicitly provisioned ADECC_CPPWINRT_MIDLRT")
+    endif()
+    # Match IDL inputs to the exact selected MIDLRT SDK version.
+    if(NOT DEFINED ADECC_CPPWINRT_IDL_ROOT)
+        get_filename_component(_adecc_midlrt_bin "${ADECC_CPPWINRT_MIDLRT}" DIRECTORY)
+        get_filename_component(_adecc_midlrt_version_dir "${_adecc_midlrt_bin}" DIRECTORY)
+        get_filename_component(_adecc_midlrt_version "${_adecc_midlrt_version_dir}" NAME)
+        get_filename_component(_adecc_midlrt_bin_root "${_adecc_midlrt_version_dir}" DIRECTORY)
+        get_filename_component(_adecc_midlrt_sdk_root "${_adecc_midlrt_bin_root}" DIRECTORY)
+        set(ADECC_CPPWINRT_IDL_ROOT "${_adecc_midlrt_sdk_root}/Include/${_adecc_midlrt_version}")
+    endif()
+    if(NOT IS_DIRECTORY "${ADECC_CPPWINRT_IDL_ROOT}/winrt" OR
+       NOT IS_DIRECTORY "${ADECC_CPPWINRT_IDL_ROOT}/shared" OR
+       NOT IS_DIRECTORY "${ADECC_CPPWINRT_IDL_ROOT}/um")
+        message(FATAL_ERROR "C++/WinRT tests require explicitly provisioned ADECC_CPPWINRT_IDL_ROOT with winrt/shared/um")
+    endif()
+    set(ADECC_CPPWINRT_WINRT_SDK_INCLUDE "${ADECC_CPPWINRT_IDL_ROOT}/winrt")
+    set(ADECC_CPPWINRT_MIDL_SHARED_INCLUDE "${ADECC_CPPWINRT_IDL_ROOT}/shared")
+    set(ADECC_CPPWINRT_MIDL_UM_INCLUDE "${ADECC_CPPWINRT_IDL_ROOT}/um")
+    set(_adecc_test_component_dir "${CMAKE_CURRENT_BINARY_DIR}/test_component")
+    set(_adecc_test_component_winmd "${_adecc_test_component_dir}/test_component.winmd")
+    # MIDLRT is a Windows-native tool; its /winmd and /out output parameters
+    # must not be supplied as CMake forward-slash paths.
+    file(TO_NATIVE_PATH "${_adecc_test_component_winmd}" _adecc_test_component_winmd_native)
+    file(TO_NATIVE_PATH "${_adecc_test_component_dir}" _adecc_test_component_dir_native)
+    set(_adecc_test_component_h "${CPPWINRT_PROJECTION_INCLUDE_DIR}/winrt/test_component.h")
+    file(MAKE_DIRECTORY "${_adecc_test_component_dir}")
+    # MIDLRT mirrors the IDL source-relative path under /out for its generated header.
+    file(MAKE_DIRECTORY "${_adecc_test_component_dir}/test_component")
+    if(NOT DEFINED ENV{CB_BCC64X} OR "$ENV{CB_BCC64X}" STREQUAL "")
+        message(FATAL_ERROR "BCC64X compiler path is required as MIDLRT C preprocessor")
+    endif()
+    # MIDLRT splits /cpp_cmd values containing spaces, even when quoted.
+    # A workspace-local wrapper preserves the registered BCC64X path as one argument.
+    # In SDK IDL, __stdcall is calling-convention syntax for MIDLRT, not a
+    # Clang __attribute__((stdcall)) expression. Strip only for IDL preprocessing.
+    set(_adecc_midl_cpp "${_adecc_test_component_dir}/bcc64x-midl-preprocess.cmd")
+    file(WRITE "${_adecc_midl_cpp}"
+        "@echo off\r\n\"$ENV{CB_BCC64X}\" %*\r\n")
+    add_custom_command(
+        OUTPUT "${_adecc_test_component_winmd}"
+        COMMAND "${ADECC_CPPWINRT_MIDLRT}"
+            /winrt /nomidl
+            /cpp_cmd "${_adecc_midl_cpp}"
+            /cpp_opt "-E -x c -U__stdcall -U_stdcall -D__stdcall= -D_stdcall="
+            /metadata_dir "$ENV{SystemRoot}/System32/WinMetadata"
+            /I "${ADECC_CPPWINRT_WINRT_SDK_INCLUDE}"
+            /I "${ADECC_CPPWINRT_MIDL_UM_INCLUDE}"
+            /I "${ADECC_CPPWINRT_MIDL_SHARED_INCLUDE}"
+            /winmd "${_adecc_test_component_winmd_native}"
+            /out "${_adecc_test_component_dir_native}"
+            "test_component/test_component.idl"
+        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/test_component/test_component.idl"
+        VERBATIM)
+    add_custom_command(
+        OUTPUT "${_adecc_test_component_h}"
+        COMMAND "$<TARGET_FILE:cppwinrt>"
+            -input "${_adecc_test_component_winmd}"
+            -reference local
+            -output "${CPPWINRT_PROJECTION_INCLUDE_DIR}"
+        DEPENDS cppwinrt "${_adecc_test_component_winmd}"
+        VERBATIM)
+    add_custom_target(build-cppwinrt-test-component-projection
+        DEPENDS "${_adecc_test_component_h}")
+    add_dependencies(build-cppwinrt-projection
+        build-cppwinrt-test-component-projection)
+endif()
 
 
 set(ENABLE_TEST_SANITIZERS FALSE CACHE BOOL "Enable ASan and UBSan for the tests.")
