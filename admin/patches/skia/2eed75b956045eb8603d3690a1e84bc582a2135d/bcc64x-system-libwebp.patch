+    assert(bcc64x_libwebp_mux_lib != "", "Managed libwebp mux import required")
+    include_dirs = [ bcc64x_libwebp_include ]
+    ldflags = [
+      bcc64x_libwebp_lib,
+      bcc64x_libwebp_demux_lib,
+      bcc64x_libwebp_mux_lib,
     ]
   }
 } else {
