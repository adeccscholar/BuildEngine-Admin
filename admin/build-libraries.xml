   <library id="pugixml" version="1.16" timestamp="2026-08-25T18:30:00Z">
      <source>
         <download url="https://github.com/zeux/pugixml/releases/download/v{LibraryVersion}/pugixml-{LibraryVersion}.zip"
                   archive="pugixml-{LibraryVersion}.zip"/>
         <extract format="zip" root="pugixml-{LibraryVersion}">
            <!-- Upstream source and build contract required by the real pugiXML 1.16 CMake project. -->
            <require path="CMakeLists.txt"/>
            <require path="src\pugixml.cpp"/>
            <require path="src\pugixml.hpp"/>
            <require path="src\pugiconfig.hpp"/>
            <require path="scripts\pugixml-config.cmake.in"/>
            <require path="scripts\pugixml.pc.in"/>
            <require path="scripts\pugixml_dll.rc"/>
            <require path="LICENSE.md"/>
         </extract>
      </source>

      <build>
         <environment name="CB_BCC64X" value="{Tool:bcc64x}"/>
         <environment name="CB_BDS" value="{BDS}"/>

         <!-- Generic CMake invocation contract. -->
         <argument value="-G"/>
         <argument value="Ninja"/>
         <argument value="-Wno-dev"/>
         <argument value="-DCMAKE_TOOLCHAIN_FILE:FILEPATH={BuildFileDir}\cmake\toolchains\bcc64x-buildengine-cxx.cmake"/>
         <argument value="-DCMAKE_MAKE_PROGRAM:FILEPATH={Tool:ninja}"/>
         <argument value="-DCMAKE_INSTALL_PREFIX:PATH={InstallRoot}\packages\{LibraryId}\{LibraryVersion}"/>
         <argument value="-DCMAKE_INSTALL_INCLUDEDIR:STRING=include"/>

         <!--
            pugiXML 1.16 upstream CMake options.  The BuildEngine does not
            replace the library's CMakeLists.txt or package-config template.
         -->
         <argument value="-DBUILD_SHARED_LIBS:BOOL=ON"/>
         <argument value="-DPUGIXML_BUILD_SHARED_AND_STATIC_LIBS:BOOL=OFF"/>
         <argument value="-DPUGIXML_INSTALL:BOOL=ON"/>
         <argument value="-DPUGIXML_INSTALL_SOURCE:BOOL=OFF"/>
         <argument value="-DPUGIXML_BUILD_TESTS:BOOL=OFF"/>
         <argument value="-DPUGIXML_USE_VERSIONED_LIBDIR:BOOL=OFF"/>
         <argument value="-DPUGIXML_USE_POSTFIX:BOOL=OFF"/>
         <argument value="-DPUGIXML_WCHAR_MODE:BOOL=OFF"/>
         <argument value="-DPUGIXML_COMPACT:BOOL=OFF"/>
         <argument value="-DPUGIXML_CHARCONV_FLOAT:BOOL=ON"/>
         <argument value="-DPUGIXML_NO_XPATH:BOOL=OFF"/>
         <argument value="-DPUGIXML_NO_STL:BOOL=OFF"/>
         <argument value="-DPUGIXML_NO_EXCEPTIONS:BOOL=OFF"/>
         <argument value="-DCMAKE_CXX_STANDARD:STRING=17"/>
         <argument value="-DCMAKE_CXX_STANDARD_REQUIRED:BOOL=ON"/>
         <argument value="-DCMAKE_CXX_EXTENSIONS:BOOL=OFF"/>

         <cmake mode="configure" executable="{Tool:cmake}"
                source="{Workspace}\pugixml-{LibraryVersion}"
                build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
         <cmake mode="build" executable="{Tool:cmake}"
                build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>

         <variant name="Release">
            <variable name="BinaryName" value="libpugixml"/>
            <variable name="CMakeExportConfiguration" value="release"/>
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Release"/>
            <argument value="-DCMAKE_CXX_FLAGS_RELEASE:STRING=-O2 -DNDEBUG"/>
            <argument value="-DCMAKE_INSTALL_LIBDIR:STRING=lib/win64/Release"/>
            <argument value="-DCMAKE_INSTALL_BINDIR:STRING=bin/win64/Release"/>
         </variant>

         <variant name="Debug">
            <variable name="BinaryName" value="libpugixmld"/>
            <variable name="CMakeExportConfiguration" value="debug"/>
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Debug"/>
            <argument value="-DCMAKE_CXX_FLAGS_DEBUG:STRING=-O0"/>
            <!-- CMake initializes DEBUG_POSTFIX on library targets from this variable. -->
            <argument value="-DCMAKE_DEBUG_POSTFIX:STRING=d"/>
            <argument value="-DCMAKE_INSTALL_LIBDIR:STRING=lib/win64/Debug"/>
            <argument value="-DCMAKE_INSTALL_BINDIR:STRING=bin/win64/Debug"/>
         </variant>

         <!--
            Current build gate only: install and verify declared files.
            These <require> actions are not compile/link/runtime smoke tests.
         -->
         <install>
            <perVariant>
               <cmake mode="install" executable="{Tool:cmake}"
                      build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\{BinaryName}.dll"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\{BinaryName}.lib"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\pugixml\pugixml-config.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\pugixml\pugixml-config-version.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\pugixml\pugixml-targets.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\pugixml\pugixml-targets-{CMakeExportConfiguration}.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\pkgconfig\pugixml.pc"/>
            </perVariant>
            <common>
               <copy source="{Workspace}\pugixml-{LibraryVersion}\LICENSE.md"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\pugixml-LICENSE.md"
                     overwrite="true"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include\pugixml.hpp"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include\pugiconfig.hpp"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\pugixml-LICENSE.md"/>
            </common>
         </install>
      </build>
   </library>

   <library id="zlib" version="1.3.2" timestamp="2026-08-25T18:30:00Z">
      <source>
         <download url="https://github.com/madler/zlib/releases/download/v{LibraryVersion}/zlib132.zip"
                   archive="zlib-{LibraryVersion}.zip"
                   sha256="e8bf55f3017aa181690990cb58a994e77885da140609fc8f94abe9b65d2cae28"/>
         <extract format="zip" root="zlib-{LibraryVersion}">
            <require path="CMakeLists.txt"/>
            <require path="zlib.h"/>
            <require path="zconf.h"/>
            <require path="LICENSE"/>
            <require path="win32\zlib1.rc"/>
            <require path="test\example.c"/>
            <require path="test\minigzip.c"/>
         </extract>
      </source>

      <build>
         <environment name="CB_BCC64X" value="{Tool:bcc64x}"/>
         <environment name="CB_BDS" value="{BDS}"/>
         <environment name="CB_LLVM_AR" value="{Tool:llvm-ar}"/>

         <argument value="-G"/>
         <argument value="Ninja"/>
         <argument value="-Wno-dev"/>
         <argument value="-DCMAKE_TOOLCHAIN_FILE:FILEPATH={BuildFileDir}\cmake\toolchains\bcc64x-buildengine-cxx.cmake"/>
         <argument value="-DCMAKE_PROJECT_INCLUDE:FILEPATH={BuildFileDir}\cmake\packages\zlib-artifact-names.cmake"/>
         <argument value="-DCMAKE_MAKE_PROGRAM:FILEPATH={Tool:ninja}"/>
         <argument value="-DGCOV_EXECUTABLE:FILEPATH={Tool:llvm-cov}"/>
         <!-- CMake resolves the resource compiler through its BCC64X platform integration. -->
         <argument value="-DCMAKE_INSTALL_PREFIX:PATH={InstallRoot}\packages\{LibraryId}\{LibraryVersion}"/>
         <argument value="-DCMAKE_INSTALL_INCLUDEDIR:STRING=include"/>
         <!-- zlib appends /zlib to CMAKE_INSTALL_DOCDIR itself. -->
         <argument value="-DCMAKE_INSTALL_DOCDIR:STRING=share/doc"/>
         <!--
            Artifact contract:
            - libz.dll/libzd.dll and the matching import .lib;
            - the independent static library, explicitly named
              libz-static.lib/libz-static-debug.lib.
         -->
         <argument value="-DZLIB_BUILD_SHARED:BOOL=ON"/>
         <argument value="-DZLIB_BUILD_STATIC:BOOL=ON"/>
         <argument value="-DZLIB_BUILD_TESTING:BOOL=ON"/>
         <argument value="-DZLIB_INSTALL:BOOL=ON"/>
         <argument value="-DZLIB_PREFIX:BOOL=OFF"/>

         <cmake mode="configure" executable="{Tool:cmake}"
                source="{Workspace}\zlib-{LibraryVersion}"
                build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
         <cmake mode="build" executable="{Tool:cmake}"
                build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>

         <variant name="Release">
            <variable name="SharedName" value="libz"/>
            <variable name="StaticName" value="libz-static"/>
            <variable name="CMakeExportConfiguration" value="release"/>
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Release"/>
            <argument value="-DCMAKE_C_FLAGS_RELEASE:STRING=-O2 -DNDEBUG"/>
            <argument value="-DCMAKE_INSTALL_LIBDIR:STRING=lib/win64/Release"/>
            <argument value="-DCMAKE_INSTALL_BINDIR:STRING=bin/win64/Release"/>
         </variant>

         <variant name="Debug">
            <variable name="SharedName" value="libzd"/>
            <variable name="StaticName" value="libz-static-debug"/>
            <variable name="CMakeExportConfiguration" value="debug"/>
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Debug"/>
            <argument value="-DCMAKE_C_FLAGS_DEBUG:STRING=-O0"/>
            <argument value="-DCMAKE_DEBUG_POSTFIX:STRING=d"/>
            <argument value="-DCMAKE_INSTALL_LIBDIR:STRING=lib/win64/Debug"/>
            <argument value="-DCMAKE_INSTALL_BINDIR:STRING=bin/win64/Debug"/>
         </variant>

         <install>
            <perVariant>
               <cmake mode="install" executable="{Tool:cmake}"
                      build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
               <!--
                  zlib 1.3.2 uses the declared portable LLVM 20.1.7 llvm-cov
                  tool in gcov compatibility mode.  No coverage or integration
                  test is excluded.  Nested CMake integration tests reuse Ninja
                  through PATH.  CMAKE_PREFIX_PATH points at zlib's deliberately
                  configuration-specific test installation, so find_package()
                  can locate the generated ZLIBConfig.cmake.
               -->
               <execute name="test" executable="{ToolDir:cmake}\ctest.exe"
                        workingDirectory="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"
                        showOutput="false">
                  <environment name="PATH" value="{ToolDir:ninja};{ENV:PATH}"/>
                  <environment name="CMAKE_PREFIX_PATH"
                               value="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}\test\test_install\lib\win64\{Configuration}\cmake\zlib"/>
                  <argument value="--output-on-failure"/>
               </execute>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\{SharedName}.dll"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\{SharedName}.lib"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\{StaticName}.lib"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\zlib\ZLIBConfig.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\zlib\ZLIBConfigVersion.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\zlib\ZLIB-shared.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\zlib\ZLIB-shared-{CMakeExportConfiguration}.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\zlib\ZLIB-static.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\zlib\ZLIB-static-{CMakeExportConfiguration}.cmake"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\pkgconfig\zlib.pc"/>
            </perVariant>
            <common>
               <copy source="{Workspace}\zlib-{LibraryVersion}\LICENSE"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\LICENSE"
                     overwrite="true"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include\zlib.h"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include\zconf.h"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\share\man\man3\zlib.3"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\share\doc\zlib\algorithm.txt"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\LICENSE"/>
            </common>
         </install>
      </build>
   </library>

   <library id="libarchive" version="3.8.9" timestamp="2026-08-26T17:20:00Z">
      <dependency library="zlib" version="1.3.2"/>
      <source>
         <download url="https://github.com/libarchive/libarchive/releases/download/v{LibraryVersion}/libarchive-{LibraryVersion}.zip"
                   archive="libarchive-{LibraryVersion}.zip"
                   sha256="7b20200203d08866b62373dd51417798427ec67852928d71f142bfe578e9ea75"/>
         <extract format="zip" root="libarchive-{LibraryVersion}">
            <require path="CMakeLists.txt"/>
            <require path="COPYING"/>
            <require path="build\version"/>
            <require path="libarchive\archive.h"/>
            <require path="libarchive\archive_entry.h"/>
            <require path="libarchive\archive_read_support_format_tar.c"/>
            <require path="tar\bsdtar.c"/>
         </extract>
         <copy source="{BuildFileDir}\patches\libarchive\3.8.9\bcc64x-modern-borland-compat.patch"
               target="{Workspace}\.buildengine\patches\{LibraryVersion}\bcc64x-modern-borland-compat.patch"
               overwrite="true" preserveCurrentArtifact="true"/>
         <!--
            BCC64X compatibility backpatch for legacy __BORLANDC__ compiler
            branches. BCC64X also defines __clang__ and must therefore use the
            modern Clang-compatible paths for inline handling, integer types
            and literals, Windows lseek/mbstate_t handling, open mode arguments,
            and the corresponding tests.

            The patch also includes the upstream Windows/Clang fix from commit
            f75ed3a20526ef4ec2f46ee94216b6efd01eab0a for filter_fork_windows.c.
            In test_read_data_large.c, an existing ftruncate macro is explicitly
            undefined before libarchive maps ftruncate to _chsize, avoiding the
            BCC64X MinGW macro redefinition while keeping Debug -Werror enabled.

            The complete verified upstream source is extracted before the patch
            is checked and applied.
         -->
         <execute name="patch-check" executable="{Tool:git}"
                  workingDirectory="{CurrentArtifact}" showOutput="false">
            <argument value="apply"/>
            <argument value="--check"/>
            <argument value="--no-index"/>
            <argument value="--unidiff-zero"/>
            <argument value="--whitespace=nowarn"/>
            <argument value="{Workspace}\.buildengine\patches\{LibraryVersion}\bcc64x-modern-borland-compat.patch"/>
         </execute>
         <execute name="patch-apply" executable="{Tool:git}"
                  workingDirectory="{CurrentArtifact}" showOutput="false">
            <argument value="apply"/>
            <argument value="--no-index"/>
            <argument value="--unidiff-zero"/>
            <argument value="--whitespace=nowarn"/>
            <argument value="{Workspace}\.buildengine\patches\{LibraryVersion}\bcc64x-modern-borland-compat.patch"/>
         </execute>
      </source>

      <build>
         <environment name="CB_BCC64X" value="{Tool:bcc64x}"/>
         <environment name="CB_BDS" value="{BDS}"/>
         <environment name="CB_LLVM_AR" value="{Tool:llvm-ar}"/>

         <argument value="-G"/>
         <argument value="Ninja"/>
         <argument value="-Wno-dev"/>
         <argument value="-DCMAKE_TOOLCHAIN_FILE:FILEPATH={BuildFileDir}\cmake\toolchains\bcc64x-buildengine-cxx.cmake"/>
         <argument value="-DCMAKE_MAKE_PROGRAM:FILEPATH={Tool:ninja}"/>
         <!-- CMake resolves the resource compiler through its BCC64X platform integration. -->
         <argument value="-DCMAKE_INSTALL_PREFIX:PATH={BuildRoot}\stage\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
         <argument value="-DCMAKE_INSTALL_LIBDIR:STRING=lib"/>
         <argument value="-DBUILD_SHARED_LIBS:BOOL=ON"/>
         <argument value="-DENABLE_INSTALL:BOOL=ON"/>
         <argument value="-DENABLE_TEST:BOOL=ON"/>

         <!--
            Complete native TAR toolset.  The package contains the runtime DLL,
            its import .lib and an independent static .lib.  The import library
            is not the static library, although both use the .lib extension.
         -->
         <argument value="-DENABLE_TAR:BOOL=ON"/>
         <argument value="-DENABLE_TAR_SHARED:BOOL=ON"/>
         <argument value="-DENABLE_CPIO:BOOL=ON"/>
         <argument value="-DENABLE_CPIO_SHARED:BOOL=ON"/>
         <argument value="-DENABLE_CAT:BOOL=ON"/>
         <argument value="-DENABLE_CAT_SHARED:BOOL=ON"/>
         <argument value="-DENABLE_UNZIP:BOOL=ON"/>
         <argument value="-DENABLE_UNZIP_SHARED:BOOL=ON"/>

         <!-- Declared compression/Windows backends; no accidental host-library pickup. -->
         <argument value="-DENABLE_ZLIB:BOOL=ON"/>
         <argument value="-DZLIB_INCLUDE_DIR:PATH={InstallRoot}\packages\zlib\1.3.2\include"/>
         <argument value="-DZLIB_LIBRARY:FILEPATH={InstallRoot}\packages\zlib\1.3.2\lib\win64\{Configuration}\{ZlibLibraryName}.lib"/>
         <argument value="-DENABLE_CNG:BOOL=ON"/>
         <argument value="-DENABLE_WIN32_XMLLITE:BOOL=ON"/>
         <argument value="-DENABLE_OPENSSL:BOOL=OFF"/>
         <argument value="-DENABLE_MBEDTLS:BOOL=OFF"/>
         <argument value="-DENABLE_NETTLE:BOOL=OFF"/>
         <argument value="-DENABLE_LIBB2:BOOL=OFF"/>
         <argument value="-DENABLE_LZ4:BOOL=OFF"/>
         <argument value="-DENABLE_LZO:BOOL=OFF"/>
         <argument value="-DENABLE_LZMA:BOOL=OFF"/>
         <argument value="-DENABLE_ZSTD:BOOL=OFF"/>
         <argument value="-DENABLE_BZip2:BOOL=OFF"/>
         <argument value="-DENABLE_LIBXML2:BOOL=OFF"/>
         <argument value="-DENABLE_EXPAT:BOOL=OFF"/>
         <!--
            BCC64X on Windows provides no libc POSIX regex implementation.
            With AUTO, libarchive otherwise enters its PCRE/libgcc fallback
            even though both optional regex backends are disabled below.
         -->
         <argument value="-DPOSIX_REGEX_LIB:STRING=NONE"/>
         <argument value="-DENABLE_PCREPOSIX:BOOL=OFF"/>
         <argument value="-DENABLE_PCRE2POSIX:BOOL=OFF"/>
         <argument value="-DENABLE_LIBGCC:BOOL=OFF"/>
         <argument value="-DENABLE_ICONV:BOOL=OFF"/>

         <cmake mode="configure" executable="{Tool:cmake}"
                source="{Workspace}\libarchive-{LibraryVersion}"
                build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
         <cmake mode="build" executable="{Tool:cmake}"
                build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>

         <variant name="Release">
            <variable name="ArchiveName" value="libarchive"/>
            <variable name="ArchiveStaticName" value="libarchive_static"/>
            <variable name="ZlibLibraryName" value="libz"/>
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Release"/>
            <argument value="-DCMAKE_C_FLAGS_RELEASE:STRING=-O2 -DNDEBUG"/>
         </variant>

         <variant name="Debug">
            <variable name="ArchiveName" value="libarchived"/>
            <variable name="ArchiveStaticName" value="libarchive_staticd"/>
            <variable name="ZlibLibraryName" value="libzd"/>
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Debug"/>
            <argument value="-DCMAKE_C_FLAGS_DEBUG:STRING=-O0"/>
            <argument value="-DCMAKE_DEBUG_POSTFIX:STRING=d"/>
         </variant>

         <install>
            <perVariant>
               <cmake mode="install" executable="{Tool:cmake}"
                      build="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
               <execute name="test" executable="{Tool:cmake}"
                        workingDirectory="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"
                        showOutput="false">
                  <argument value="--build"/>
                  <argument value="."/>
                  <argument value="--target"/>
                  <argument value="test"/>
               </execute>
               <copy source="{BuildRoot}\stage\packages\{LibraryId}\{LibraryVersion}\{Configuration}\bin"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}"
                     recursive="true" overwrite="true"/>
               <copy source="{BuildRoot}\stage\packages\{LibraryId}\{LibraryVersion}\{Configuration}\lib"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}"
                     recursive="true" overwrite="true"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\{ArchiveName}.dll"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\bsdtar.exe"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\bsdcpio.exe"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\bsdcat.exe"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration}\bsdunzip.exe"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\{ArchiveName}.lib"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\{ArchiveStaticName}.lib"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\pkgconfig\libarchive.pc"/>
            </perVariant>
            <common>
               <copy source="{BuildRoot}\stage\packages\{LibraryId}\{LibraryVersion}\Release\include"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include"
                     recursive="true" overwrite="true"/>
               <copy source="{BuildRoot}\stage\packages\{LibraryId}\{LibraryVersion}\Release\share"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\share"
                     recursive="true" overwrite="true"/>
               <copy source="{Workspace}\libarchive-{LibraryVersion}\COPYING"
                     target="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\COPYING"
                     overwrite="true"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include\archive.h"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\include\archive_entry.h"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\share\man\man1\bsdtar.1"/>
               <require path="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\COPYING"/>
            </common>
         </install>
      </build>
   </library>

   <library id="openssl" version="3.5.8" timestamp="2026-08-26T22:30:00Z">
      <source>
         <download url="https://github.com/openssl/openssl/releases/download/openssl-{LibraryVersion}/openssl-{LibraryVersion}.tar.gz"
                   archive="openssl-{LibraryVersion}.tar.gz"
                   sha256="a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2"/>
         <extract format="libarchive" root="openssl-{LibraryVersion}">
            <require path="Configure"/>
            <require path="LICENSE.txt"/>
            <require path="Configurations\10-main.conf"/>
            <require path="Configurations\shared-info.pl"/>
         </extract>
         <copy source="{BuildFileDir}\patches\openssl\3.5.8\bcc64x-memory-barrier.patch"
               target="{Workspace}\.buildengine\patches\{LibraryVersion}\bcc64x-memory-barrier.patch"
               overwrite="true" preserveCurrentArtifact="true"/>
         <!--
            BCC64X defines both __BORLANDC__ and __clang__. In the current
            Embarcadero Win64/COFF headers the WinSDK MemoryBarrier macro used
            by OpenSSL's Windows run-once implementation is not exposed, while
            the Interlocked API is available. For Clang-based Embarcadero
            compilers the patch publishes ONCE_DONE through InterlockedExchange,
            which also provides the required full memory barrier.
         -->
         <execute name="patch-check" executable="{Tool:git}"
                  workingDirectory="{CurrentArtifact}" showOutput="false">
            <argument value="apply"/>
            <argument value="--check"/>
            <argument value="--no-index"/>
            <argument value="--whitespace=nowarn"/>
            <argument value="{Workspace}\.buildengine\patches\{LibraryVersion}\bcc64x-memory-barrier.patch"/>
         </execute>
         <execute name="patch-apply" executable="{Tool:git}"
                  workingDirectory="{CurrentArtifact}" showOutput="false">
            <argument value="apply"/>
            <argument value="--no-index"/>
            <argument value="--whitespace=nowarn"/>
            <argument value="{Workspace}\.buildengine\patches\{LibraryVersion}\bcc64x-memory-barrier.patch"/>
         </execute>
      </source>

      <build>
         <!--
            Native BCC64X OpenSSL build.  All OpenSSL target knowledge remains in this XML contract.
            The perl target materializes the OpenSSL Configure target file in the variant build tree.
         -->
         <environment name="PATH"
                      value="{ToolDir:embarcadero-make};{ToolDir:bcc64x};{ToolDir:llvm-ar};{ToolDir:llvm-ranlib};{ToolDir:bcc64x-windres};{ToolDir:perl};{ENV:PATH}"/>

         <execute name="remove-build" executable="{Tool:cmake}"
                  workingDirectory="{ProductionRoot}" showOutput="false">
            <argument value="-E"/>
            <argument value="remove_directory"/>
            <argument value="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
         </execute>
         <execute name="create-build" executable="{Tool:cmake}"
                  workingDirectory="{ProductionRoot}" showOutput="false">
            <argument value="-E"/>
            <argument value="make_directory"/>
            <argument value="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"/>
         </execute>

         <target name="configure" type="perl" executable="{Tool:perl}"
                 workingDirectory="{BuildRoot}\packages\{LibraryId}\{LibraryVersion}\{Configuration}"
                 showOutput="true">
            <parameter name="TargetName" value="BCC64X-WIN64"/>
            <parameter name="BaseTarget" value="BASE_Windows"/>
            <parameter name="CC" value="bcc64x"/>
            <parameter name="CXX" value="bcc64x"/>
            <parameter name="CPP" value="bcc64x -E"/>
            <parameter name="LD" value="bcc64x"/>
            <parameter name="AR" value="llvm-ar"/>
            <parameter name="ARFlags" value="qc"/>
            <parameter name="RANLIB" value="llvm-ranlib"/>
            <parameter name="RC" value="bcc64x-windres"/>
            <parameter name="CFlags" value="{OpenSSLCFlags}"/>
            <parameter name="SystemLibraries" value="-lws2_32 -lgdi32 -lcrypt32 -luser32 -ladvapi32"/>
            <parameter name="ThreadScheme" value="winthreads"/>
            <parameter name="DsoScheme" value="win64"/>
            <parameter name="SharedTarget" value="win-shared"/>
