diff --git a/third_party/third_party.gni b/third_party/third_party.gni
index 1fe96e9..3c6feed 100644
--- a/third_party/third_party.gni
+++ b/third_party/third_party.gni
@@ -107,7 +107,17 @@ template("system") {
   config(target_name + "_public") {
     forward_variables_from(invoker, "*", [])
   }
+
+  if (skia_use_bcc64x && defined(invoker.ldflags)) {
+    config(target_name + "_bcc64x_link") {
+      ldflags = invoker.ldflags
+    }
+  }
+
   group(target_name) {
     public_configs = [ ":" + target_name + "_public" ]
+    if (skia_use_bcc64x && defined(invoker.ldflags)) {
+      all_dependent_configs = [ ":" + target_name + "_bcc64x_link" ]
+    }
   }
 }

diff --git a/BUILD.gn b/BUILD.gn
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -133,3 +133,6 @@ config("skia_library") {
   visibility = [ "./*" ]
   defines = [ "SKIA_IMPLEMENTATION=1" ]
+  if (is_component_build && skia_use_bcc64x) {
+    cflags = [ "-fvisibility=default" ]
+  }
 }

diff --git a/gn/skia.gni b/gn/skia.gni
--- a/gn/skia.gni
+++ b/gn/skia.gni
@@ -273,7 +273,25 @@ template("skia_shared_library") {
 template("skia_component") {
   skia_target(target_name) {
     assert(!defined(configs), "No set_defaults(skia_target)")
+    # BCC64X uses a hybrid component build. Only components with an audited
+    # DLL ABI are shared; implementation-only components stay static and are
+    # linked into their consuming component.
+    _bcc64x_shared_component =
+        target_name == "skia" ||
+        target_name == "skunicode_core" ||
+        target_name == "skunicode_icu" ||
+        target_name == "skunicode_client_icu" ||
+        target_name == "skunicode_bidi" ||
+        target_name == "skunicode_libgrapheme" ||
+        target_name == "skunicode_icu4x" ||
+        target_name == "skshaper" ||
+        target_name == "svg" ||
+        target_name == "skottie"
     _skia_target_type = "component"
+    if (skia_use_bcc64x && is_component_build &&
+        !_bcc64x_shared_component) {
+      _skia_target_type = "static_library"
+    }
     forward_variables_from(invoker, "*")
   }
 }

