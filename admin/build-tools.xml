   <!--
      MiKTeX is provisioned only when the effective documentation contract asks
      for LaTeX/PDF output. The managed preparation contract is tied to Doxygen
      1.18.0 and installs its explicit LaTeX package surface before any PDF job.
      Library PDF jobs keep automatic package installation disabled.
   -->
   <tool id="miktex" version="25.12" required="when-used">
      <managed root="miktex\25.12-portable" executable="texmfs\install\miktex\bin\x64\texify.exe">
         <download url="https://mirrors.ibiblio.org/CTAN/systems/win32/miktex/setup/windows-x64/basic-miktex-25.12-x64.exe"
                   archive="basic-miktex-25.12-x64.exe"
                   sha256="14b42dd9f4b4a7813a8bfd69c8f99316c2888cc4ee26f631f397e163d85d6c62"/>
         <extract executable="{Archive}">
            <argument value="--portable={ManagedRoot}"/>
            <argument value="--unattended"/>
            <argument value="--no-registry"/>
            <argument value="--no-additional-roots"/>
            <argument value="--paper-size=A4"/>
         </extract>
         <prepare marker=".buildengine\doxygen-1.18.0-latex-packages-v1.txt">
            <command executable="texmfs\install\miktex\bin\x64\miktex.exe">
               <argument value="packages"/><argument value="update-package-database"/>
               <argument value="--repository"/><argument value="https://mirrors.ibiblio.org/CTAN/systems/win32/miktex/tm/packages/"/>
            </command>
            <command executable="texmfs\install\miktex\bin\x64\miktex.exe">
               <argument value="packages"/><argument value="check-update"/>
               <argument value="--repository"/><argument value="https://mirrors.ibiblio.org/CTAN/systems/win32/miktex/tm/packages/"/>
               <success code="0"/><success code="100"/>
            </command>
            <!-- Resolve the five missing dependencies reported by Basic MiKTeX 25.12 itself. -->
            <command executable="texmfs\install\miktex\bin\x64\miktex.exe">
               <argument value="packages"/><argument value="install"/>
               <argument value="--repository"/><argument value="https://mirrors.ibiblio.org/CTAN/systems/win32/miktex/tm/packages/"/>
               <argument value="ms"/><argument value="showframe"/><argument value="sttools"/><argument value="thailatex"/><argument value="luxi"/>
            </command>
            <!--
               Doxygen Release_1_18_0 direct/default LaTeX contract:
               header.tex + doxygen.sty + default PDFLaTeX font selection.
               MiKTeX resolves transitive dependencies of these explicit package IDs.
            -->
            <command executable="texmfs\install\miktex\bin\x64\miktex.exe">
               <argument value="packages"/><argument value="install"/>
               <argument value="--repository"/><argument value="https://mirrors.ibiblio.org/CTAN/systems/win32/miktex/tm/packages/"/>
               <argument value="ltxbase"/><argument value="latex-tools"/><argument value="graphics"/><argument value="amsfonts"/><argument value="psnfss"/>
               <argument value="infwarerr"/><argument value="float"/><argument value="varwidth"/><argument value="xcolor"/><argument value="colortbl"/>
               <argument value="xltabular"/><argument value="tabularray"/><argument value="fancyvrb"/><argument value="multirow"/>
               <argument value="hanging"/><argument value="ifpdf"/><argument value="adjustbox"/><argument value="stackengine"/>
               <argument value="enumitem"/><argument value="alphalph"/><argument value="ulem"/><argument value="iftex"/>
               <argument value="ifxetex"/><argument value="wasysym"/><argument value="geometry"/><argument value="changepage"/>
               <argument value="fancyhdr"/><argument value="natbib"/><argument value="tocloft"/><argument value="hyperref"/>
               <argument value="caption"/><argument value="etoc"/>
            </command>
            <command executable="texmfs\install\miktex\bin\x64\miktex.exe">
               <argument value="packages"/><argument value="verify"/>
               <argument value="ltxbase"/><argument value="latex-tools"/><argument value="graphics"/><argument value="amsfonts"/><argument value="psnfss"/>
               <argument value="infwarerr"/><argument value="float"/><argument value="varwidth"/><argument value="xcolor"/><argument value="colortbl"/>
               <argument value="xltabular"/><argument value="tabularray"/><argument value="fancyvrb"/><argument value="multirow"/>
               <argument value="hanging"/><argument value="ifpdf"/><argument value="adjustbox"/><argument value="stackengine"/>
               <argument value="enumitem"/><argument value="alphalph"/><argument value="ulem"/><argument value="iftex"/>
               <argument value="ifxetex"/><argument value="wasysym"/><argument value="geometry"/><argument value="changepage"/>
               <argument value="fancyhdr"/><argument value="natbib"/><argument value="tocloft"/><argument value="hyperref"/>
               <argument value="caption"/><argument value="etoc"/>
            </command>
            <command executable="texmfs\install\miktex\bin\x64\miktex.exe">
               <argument value="fndb"/><argument value="refresh"/>
            </command>
         </prepare>
      </managed>
      <probe contains="MiKTeX"><argument value="--version"/></probe>
   </tool>

   <!--
      Graphviz is part of the reproducible documentation toolchain, not a BCC64X target artifact.
      The official Windows ZIP contains the complete tools/libraries/plugins/runtime tree below its
      package directory Graphviz-15.1.1-win64. BuildEngine's built-in ZIP extraction preserves that
      directory, therefore the managed executable follows the package layout explicitly.
   -->
   <tool id="graphviz" version="15.1.1" required="always">
      <managed root="graphviz\15.1.1" executable="Graphviz-15.1.1-win64\bin\dot.exe">
         <download url="https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/15.1.1/windows_10_cmake_Release_Graphviz-15.1.1-win64.zip"
                   archive="Graphviz-15.1.1-win64.zip"
                   sha256="e8256ef077e601d9f284378d96cd17faa7910832cf6bb85c43005e66ec2f255e"/>
      </managed>
      <probe contains="graphviz version 15.1.1"><argument value="-V"/></probe>
   </tool>

