<?xml version="1.0" encoding="utf-8"?>
<buildDocumentation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:noNamespaceSchemaLocation="schemas/build-documentation.xsd"
                    schemaVersion="1"
                    doxygen="true"
                    source="false"
                    inlineSource="false"
                    publicOnly="false">
   <!--
      Central documentation policy for every library in the sibling
      build-libraries.xml contract.

      A library does not need an entry here to be documented. The root profile
      is inherited by every library. <library> nodes are overrides only.

      doxygen="false" disables only Doxygen for the selected library. The
      BuildEngine still generates the library information page, license
      information and SBOM view when documentation is enabled globally.

      These definitions affect Doxygen preprocessing only. They never change
      the compiler, target ABI or library build contract.
   -->

   <library id="boost" publicOnly="true">
      <!-- Proven BCC64X documentation model: Clang 20 / C++23. -->
      <define name="__clang__" value="1"/>
      <define name="__clang_major__" value="20"/>
      <define name="__clang_minor__" value="1"/>
      <define name="__cplusplus" value="202302L"/>
      <define name="BOOST_FUSION_HAS_VARIADIC_DEQUE" value="1"/>
      <define name="BOOST_FUSION_HAS_VARIADIC_VECTOR" value="1"/>
      <define name="BOOST_FUSION_HAS_VARIADIC_LIST" value="1"/>
      <define name="BOOST_FUSION_HAS_VARIADIC_MAP" value="1"/>
      <define name="BOOST_FUSION_HAS_VARIADIC_SET" value="1"/>
      <define name="BOOST_FUSION_HAS_VARIADIC_TUPLE" value="1"/>

      <!--
         Boost 1.92 documentation modes. These names are taken from the
         libraries' own Doxyfile/Jamfile contracts. They select deliberately
         simplified public declarations and suppress implementation-only code.
      -->
      <define name="DOXYGEN_INVOKED" value=""/>
      <define name="DOXYGEN_SHOULD_SKIP_THIS" value=""/>
      <define name="DOXYGEN_NO_DISPATCH" value=""/>
      <define name="DOXYGEN_NO_IMPL" value=""/>
      <define name="DOXYGEN_NO_DETAIL" value=""/>
      <define name="DOXYGEN_NO_CONCEPT_MEMBERS" value=""/>
      <define name="DOXYGEN_NO_TRAITS_SPECIALIZATIONS" value=""/>
      <define name="DOXYGEN_NO_STRATEGY_SPECIALIZATIONS" value=""/>
      <define name="DOXYGEN_NO_SPECIALIZATIONS" value=""/>
      <define name="BOOST_CONCEPT_REQUIRES(x)" value=""/>
      <define name="BOOST_CONCEPT_ASSERT(x)" value=""/>

      <define name="BOOST_ALGORITHM_DOXYGEN" value="1"/>
      <define name="BOOST_BEAST_DOXYGEN" value="1"/>
      <define name="BOOST_BEAST_USE_POSIX_FILE" value="1"/>
      <define name="BOOST_BEAST_USE_WIN32_FILE" value="1"/>
      <define name="BOOST_BEAST_SPLIT_COMPILATION" value="1"/>
      <define name="GENERATING_DOCUMENTATION" value="1"/>
      <define name="BOOST_BIMAP_DOXYGEN_WILL_NOT_PROCESS_THE_FOLLOWING_LINES" value="1"/>
      <define name="BOOST_BIMAP_ONLY_DOXYGEN_WILL_PROCESS_THE_FOLLOWING_LINES" value="1"/>
      <define name="BOOST_COMPUTE_DOXYGEN_INVOKED" value="1"/>
      <define name="BOOST_CONTAINER_DOXYGEN_INVOKED" value="1"/>
      <define name="BOOST_FILESYSTEM_DOXYGEN" value="1"/>
      <define name="BOOST_HANA_DOXYGEN_INVOKED" value="1"/>
      <define name="BOOST_HISTOGRAM_DOXYGEN_INVOKED" value="1"/>
      <define name="BOOST_INTERPROCESS_DOXYGEN_INVOKED" value="1"/>
      <define name="BOOST_JSON_DOCS" value="1"/>
      <define name="BOOST_LOG_DOXYGEN_PASS" value="1"/>
      <define name="BOOST_NOWIDE_DOXYGEN" value="1"/>
      <define name="BOOST_PARSER_DOXYGEN" value="1"/>
      <define name="BOOST_PARSER_USE_CONCEPTS" value="1"/>
      <define name="BOOST_TEST_DOXYGEN_DOC__" value="1"/>

      <exclude pattern="*/libs/*/test/*"/>
      <exclude pattern="*/libs/*/example/*"/>
      <exclude pattern="*/libs/*/examples/*"/>
      <exclude pattern="*/libs/*/doc/example/*"/>
      <exclude pattern="*/tools/*"/>
   </library>

   <library id="skia" publicOnly="true">
      <exclude pattern="*/tests/*"/>
      <exclude pattern="*/gm/*"/>
      <exclude pattern="*/bench/*"/>
      <exclude pattern="*/fuzz/*"/>
      <exclude pattern="*/tools/*"/>
      <exclude pattern="*/infra/*"/>
      <exclude pattern="*/third_party/*"/>
   </library>

   <library id="ace-tao" publicOnly="true">
      <exclude pattern="*/tests/*"/>
      <exclude pattern="*/examples/*"/>
      <exclude pattern="*/performance-tests/*"/>
      <exclude pattern="*/performance_tests/*"/>
      <exclude pattern="*/bin/*"/>
      <exclude pattern="*/MPC/*"/>
   </library>

   <library id="opencv" publicOnly="true">
      <exclude pattern="*/modules/*/test/*"/>
      <exclude pattern="*/modules/*/perf/*"/>
      <exclude pattern="*/samples/*"/>
      <exclude pattern="*/apps/*"/>
      <exclude pattern="*/doc/tutorials/*"/>
      <exclude pattern="*/3rdparty/*"/>
   </library>
</buildDocumentation>
