+ # BCC64X uses Clang/GNU response-file tokenization even on Windows.
+ # Keep Windows paths for make itself, but optionally use forward slashes
+ # for paths written inside linker response files.
+ sub ld_resp_path {
+     my $path = shift;
+     $path =~ s|\\|/|g if $target{ld_resp_forward_slashes};
+     return $path;
+ }
+
   sub generatetarget {
       my %args = @_;
