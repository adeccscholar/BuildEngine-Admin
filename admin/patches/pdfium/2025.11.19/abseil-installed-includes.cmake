# PDFium 2025.11.19 pinned at a84323421e94f484faca52dd9d027934eba42ab8.
# Versioned source patch: PDFium uses the installed Abseil 20260817.0 headers.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED PDFIUM_SOURCE_ROOT OR NOT IS_DIRECTORY "${PDFIUM_SOURCE_ROOT}")
  message(FATAL_ERROR "PDFIUM_SOURCE_ROOT must point to the extracted PDFium tree")
endif()
# In Build: read-only verification; Debug and Release may run concurrently.
# In Source: rewrite includes once, before either build variant starts.
if(NOT DEFINED ABSEIL_INCLUDE_VERIFY_ONLY)
  set(ABSEIL_INCLUDE_VERIFY_ONLY OFF)
endif()
set(_old "third_party/abseil-cpp/absl/")
set(_new "absl/")
set(_patched 0)
set(_total 0)
set(_directories core fpdfsdk fxbarcode fxjs public samples skia testing xfa third_party)
set(_paths)
foreach(_dir IN LISTS _directories)
  foreach(_ext h hpp c cc cpp cxx mm)
    file(GLOB_RECURSE _found LIST_DIRECTORIES FALSE "${PDFIUM_SOURCE_ROOT}/${_dir}/*.${_ext}")
    list(APPEND _paths ${_found})
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _paths)
list(SORT _paths)
foreach(_path IN LISTS _paths)
  file(READ "${_path}" _before)
  string(REGEX MATCHALL "#[ \t]*include[ \t]*[\"<]third_party/abseil-cpp/absl/[^\">\r\n]+[\">]" _matches "${_before}")
  if(_matches)
    if(ABSEIL_INCLUDE_VERIFY_ONLY)
      file(RELATIVE_PATH _relative "${PDFIUM_SOURCE_ROOT}" "${_path}")
      message(FATAL_ERROR "[ABSEIL-INCLUDE-VERIFY] Source state is stale: ${_relative} still uses third_party/abseil-cpp/absl/. Re-run PDFium Source patch before GN/Ninja.")
    endif()
    string(REPLACE "\"${_old}" "\"${_new}" _after "${_before}")
    string(REPLACE "<${_old}" "<${_new}" _after "${_after}")
    if(_after STREQUAL _before)
      message(FATAL_ERROR "Abseil include rewrite failed: ${_path}")
    endif()
    file(WRITE "${_path}" "${_after}")
    list(LENGTH _matches _count)
    math(EXPR _total "${_total} + ${_count}")
    math(EXPR _patched "${_patched} + 1")
    file(RELATIVE_PATH _relative "${PDFIUM_SOURCE_ROOT}" "${_path}")
    message(STATUS "[ABSEIL-INCLUDE-PATCH] ${_relative}: ${_count}")
  endif()
  file(READ "${_path}" _verify)
  if(_verify MATCHES "#[ \t]*include[ \t]*[\"<]third_party/abseil-cpp/absl/")
    message(FATAL_ERROR "Bundled Abseil include remains: ${_path}")
  endif()
endforeach()
# Check pinned upstream files even when a source state is resumed.
foreach(_sample IN ITEMS
    "core/fpdfdoc/cpdf_nametree.cpp|absl/container/flat_hash_set.h"
    "core/fpdfapi/page/cpdf_sampledfunc.cpp|absl/container/inlined_vector.h")
  string(REPLACE "|" ";" _parts "${_sample}")
  list(GET _parts 0 _file)
  list(GET _parts 1 _header)
  if(NOT EXISTS "${PDFIUM_SOURCE_ROOT}/${_file}")
    message(FATAL_ERROR "Pinned PDFium source file missing: ${_file}")
  endif()
  file(READ "${PDFIUM_SOURCE_ROOT}/${_file}" _text)
  string(FIND "${_text}" "\"${_header}\"" _at)
  if(_at LESS 0)
    message(FATAL_ERROR "Installed Abseil include missing in ${_file}: ${_header}")
  endif()
endforeach()
message(STATUS "[ABSEIL-INCLUDE-PATCH] PASS: ${_total} rewritten includes in ${_patched} source files; all checked")
