diff --git a/run_and_diff.cmake b/run_and_diff.cmake
new file mode 100644
index 0000000..81a113e
--- /dev/null
+++ b/run_and_diff.cmake
@@ -0,0 +1,52 @@
+# Ensure output directory exists
+get_filename_component(_outdir "${STDOUT}" DIRECTORY)
+file(MAKE_DIRECTORY "${_outdir}")
+
+# Run the program
+execute_process(
+    COMMAND "${PROG}" --shell "${XML}"
+    INPUT_FILE "${STDIN}"
+    OUTPUT_FILE "${STDOUT}"
+    ERROR_FILE  "${STDERR}"
+    RESULT_VARIABLE rc
+    WORKING_DIRECTORY "${WORKDIR}"
+ )
+
+if(NOT rc EQUAL 0)
+    message(STATUS "Program exited with ${rc}")
+endif()
+
+# Diff stdout
+if(NOT EXISTS "${EXPECTED_STDOUT}")
+    message(FATAL_ERROR "Missing expected stdout file: ${EXPECTED_STDOUT}")
+endif()
+
+file(READ "${STDOUT}" actual_stdout)
+file(READ "${EXPECTED_STDOUT}" expected_stdout)
+string(REPLACE "\r\n" "\n" actual_stdout "${actual_stdout}")
+string(REPLACE "\r\n" "\n" expected_stdout "${expected_stdout}")
+
+if(NOT actual_stdout STREQUAL expected_stdout)
+    message(STATUS "Actual stdout: [${actual_stdout}]")
+    message(STATUS "Expected stdout: [${expected_stdout}]")
+    message(FATAL_ERROR "stdout does not match expected")
+endif()
+
+# Diff stderr if it exists. Normalize CRLF/LF for native Windows tools.
+if(EXISTS "${EXPECTED_STDERR}")
+    file(READ "${STDERR}" actual_stderr)
+    file(READ "${EXPECTED_STDERR}" expected_stderr)
+    string(REPLACE "\r\n" "\n" actual_stderr "${actual_stderr}")
+    string(REPLACE "\r\n" "\n" expected_stderr "${expected_stderr}")
+    string(REPLACE "\r" "\n" actual_stderr "${actual_stderr}")
+    string(REPLACE "\r" "\n" expected_stderr "${expected_stderr}")
+    string(REPLACE "\\" "/" actual_stderr "${actual_stderr}")
+    string(REPLACE "\\" "/" expected_stderr "${expected_stderr}")
+    if(NOT actual_stderr STREQUAL expected_stderr)
+        string(REPLACE "\n" "\\n" actual_stderr_one_line "${actual_stderr}")
+        string(REPLACE "\n" "\\n" expected_stderr_one_line "${expected_stderr}")
+        message(FATAL_ERROR "stderr does not match expected: actual=[${actual_stderr_one_line}] expected=[${expected_stderr_one_line}]")
+    endif()
+endif()
+diff --git a/test_xmlcatalog_add_del.cmake b/test_xmlcatalog_add_del.cmake
new file mode 100644
index 0000000..c124e59
--- /dev/null
+++ b/test_xmlcatalog_add_del.cmake
@@ -0,0 +1,35 @@
+# test_xmlcatalog_add_del.cmake
+cmake_minimum_required(VERSION 3.16)
+
+set(WORK "${CMAKE_CURRENT_BINARY_DIR}/catalog_add_del_work")
+file(REMOVE_RECURSE "${WORK}")
+file(MAKE_DIRECTORY "${WORK}")
+
+set(CAT "${WORK}/mycatalog")
+
+# small helper macro (shorter execute_process)
+macro(run)
+    execute_process(COMMAND ${ARGV} RESULT_VARIABLE rv)
+    if(rv)
+        message(FATAL_ERROR "Command failed: ${ARGV}")
+    endif()
+endmacro()
+
+# 1. Create
+run("${XMLCAT}" --create --noout "${CAT}")
+
+# 2. Adds
+run("${XMLCAT}" --noout --add public Pubid  sysid  "${CAT}")
+run("${XMLCAT}" --noout --add public Pubid2 sysid2 "${CAT}")
+run("${XMLCAT}" --noout --add public Pubid3 sysid3 "${CAT}")
+
+# Check full contents
+run(${CMAKE_COMMAND} -E compare_files "${CAT}" "${EXPECTED_FULL}")
+
+# 3. Deletes
+run("${XMLCAT}" --noout --del sysid  "${CAT}")
+run("${XMLCAT}" --noout --del sysid3 "${CAT}")
+run("${XMLCAT}" --noout --del sysid2 "${CAT}")
+
+# Check empty contents
+run(${CMAKE_COMMAND} -E compare_files "${CAT}" "${EXPECTED_EMPTY}")
