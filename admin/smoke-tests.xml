<?xml version="1.0" encoding="utf-8"?>
<smokeTests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="schemas/smoke-tests.xsd"
            schemaVersion="2">
   <!--
      Smoke-test sources are version-independent and live in the separately
      synchronized BuildEngineSmokeTests repository. Version applicability
      belongs to this administrative contract.
   -->
   <library id="pugixml">
      <smoke id="installed-consumer-charconv"
             source="pugixml\installed-consumer-charconv"
             enabled="true"
             minVersion="1.16">
         <description value="Consume the installed upstream CMake package and verify the floating-point charconv path."/>
         <variant name="Release"/>
         <variant name="Debug"/>
         <expectation kind="compile-definition" value="PUGIXML_CHARCONV_FLOAT"/>
         <expectation kind="package-target" value="pugixml::pugixml"/>
         <expectation kind="behavior" value="double-roundtrip"/>
      </smoke>
   </library>
</smokeTests>
