diff --git a/cmake/libgav1_install.cmake b/cmake/libgav1_install.cmake
--- a/cmake/libgav1_install.cmake
+++ b/cmake/libgav1_install.cmake
@@ -55,7 +55,15 @@
     install(TARGETS libgav1_static DESTINATION
