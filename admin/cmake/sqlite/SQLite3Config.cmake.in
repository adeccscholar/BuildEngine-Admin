get_filename_component(_SQLITE_LIBROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
get_filename_component(_SQLITE_PKGROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
if(NOT TARGET SQLite::SQLite3)
  add_library(SQLite::SQLite3 SHARED IMPORTED)
  set_target_properties(SQLite::SQLite3 PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_SQLITE_PKGROOT}/include" IMPORTED_IMPLIB "${_SQLITE_LIBROOT}/@_base@.lib" IMPORTED_LOCATION "${_SQLITE_PKGROOT}/bin/win64/@CMAKE_BUILD_TYPE@/@_base@.dll")
endif()
set(SQLite3_FOUND TRUE)
unset(_SQLITE_LIBROOT)
unset(_SQLITE_PKGROOT)
