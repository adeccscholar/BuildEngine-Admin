# BuildEngine BCC64X toolchain for PDFium on Windows x64.
# Use the locally provisioned Embarcadero compiler and LLVM archive tool.
toolchain("bcc64x") {
  toolchain_args = {
    current_cpu = "x64"
    current_os = "win"
    is_clang = true
  }

  _cc = getenv("CB_BCC64X")
  _python = getenv("CB_PYTHON")
  _adapter = getenv("CB_GN_ARGUMENT_ADAPTER")
  assert(_python != "" && _adapter != "", "BCC64X argument adapter must be provided")
  _bds = getenv("CB_BDS")
  assert(_bds != "", "BuildEngine BCC64X installation root was not provided")
  _bcc64x_mingw_lib_dir = _bds + "/x86_64-w64-mingw32/lib"
  _ar = getenv("CB_LLVM_AR")
  _ucrt = getenv("CB_BCC64X_UCRT_COMPAT")
  assert(_ucrt != "", "BuildEngine BCC64X UCRT compatibility archive was not provided")
  assert(_cc != "", "BuildEngine BCC64X executable was not provided")
  assert(_ar != "", "BuildEngine LLVM archiver was not provided")

  # PDFium dependencies are resolved in its pinned upstream source tree.
  # Preserve GN's flags; unsupported options must be diagnosed, not discarded.
  # BCC64X is native Windows, not MinGW/POSIX. The pinned Abseil release
  # defaults to pthread TLS for this detected compiler profile; force its
  # supported C++11 thread_local/RAII identity mode throughout this toolchain.
  # Diagnostic A/B build: disable CFG consistently in PDFium objects and DLL.
  # Clang: -mguard=none; MinGW LLD: --no-guard-cf. Do not alter Skia.
  tool("cc") {
    command = "\"$_python\" \"$_adapter\" \"$_cc\" -DWIN32 -DUSE_SYSTEM_ICUUC -DUSE_SYSTEM_ZLIB -DUSE_SYSTEM_LIBJPEG -c {{source}} -o {{output}} {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -mguard=none"
    outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    description = "BCC64X CC {{source}}"
  }
  tool("cxx") {
    command = "\"$_python\" \"$_adapter\" \"$_cc\" -std=c++20 -DWIN32 -DUSE_SYSTEM_ICUUC -DUSE_SYSTEM_ZLIB -DUSE_SYSTEM_LIBJPEG -DABSL_FORCE_THREAD_IDENTITY_MODE=2 -c {{source}} -o {{output}} {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -mguard=none"
    outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    description = "BCC64X CXX {{source}}"
  }
  tool("alink") {
    rspfile = "{{output}}.rsp"
    rspfile_content = "{{inputs}}"
    command = "\"$_ar\" rcs {{output}} @$rspfile"
    outputs = [ "{{target_out_dir}}/{{target_output_name}}.lib" ]
    description = "AR {{output}}"
  }
  tool("link") {
    rspfile = "{{output}}.rsp"
    rspfile_content = "{{ldflags}} {{inputs}} $_ucrt {{solibs}} {{libs}}"
    command = "\"$_python\" \"$_adapter\" --link-rsp \"$_cc\" \"$rspfile\" --rsp-quoting=windows -L\"$_bcc64x_mingw_lib_dir\" -tR -o {{output}}"
    outputs = [ "{{root_out_dir}}/{{target_output_name}}.exe" ]
    description = "BCC64X LINK {{output}}"
  }
  tool("solink") {
    dllname = "{{root_out_dir}}/{{target_output_name}}.dll"
    implib = "{{root_out_dir}}/{{target_output_name}}.lib"
    rspfile = "$dllname.rsp"
    rspfile_content = "{{ldflags}} {{inputs}} $_ucrt {{solibs}} {{libs}}"
    command = "\"$_python\" \"$_adapter\" --link-rsp \"$_cc\" \"$rspfile\" --rsp-quoting=windows -L\"$_bcc64x_mingw_lib_dir\" -tD -tR -Wl,--subsystem,windows -Wl,--no-guard-cf -Wl,--out-implib,$implib -o $dllname"
    outputs = [ dllname, implib ]
    default_output_extension = ".dll"
    default_output_dir = "{{root_out_dir}}"
    link_output = implib
    depend_output = implib
    runtime_outputs = [ dllname ]
    description = "BCC64X DLL $dllname"
  }
  tool("stamp") {
    command = "cmd /c copy /b nul {{output}} >nul"
    description = "STAMP {{output}}"
  }
  tool("copy") {
    command = "cmd /c copy /y {{source}} {{output}} >nul"
    description = "COPY {{source}}"
  }
}
