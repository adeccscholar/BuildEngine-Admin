+vtk_module_add_module(VTK::RenderingOpenGL2
+  CLASSES ${classes}
+  PRIVATE_CLASSES ${private_classes}
+  SOURCES ${sources} ${vtk_object_factory_source} ${private_sources}
+  HEADERS ${headers}
+  NOWRAP_HEADERS ${nowrap_headers}
+  PRIVATE_HEADERS ${private_headers} ${vtk_object_factory_header})
+
+# Resolve WinRT WRL headers through BuildEngine's registered Windows SDK.
+if (VTK_USE_WIN32_OPENGL AND VTK_USE_WIN32_OPENGL_DX_INTEROP)
+  if (NOT DEFINED ENV{CB_WINDOWS_RC} OR "$ENV{CB_WINDOWS_RC}" STREQUAL "")
+    message(FATAL_ERROR "VTK OpenGL2 requires a registered Windows SDK RC tool")
+  endif ()
+  get_filename_component(_vtk_rc_arch "$ENV{CB_WINDOWS_RC}" DIRECTORY)
+  get_filename_component(_vtk_rc_ver_dir "${_vtk_rc_arch}" DIRECTORY)
+  get_filename_component(_vtk_rc_ver "${_vtk_rc_ver_dir}" NAME)
+  get_filename_component(_vtk_rc_bin "${_vtk_rc_ver_dir}" DIRECTORY)
+  get_filename_component(_vtk_rc_sdk "${_vtk_rc_bin}" DIRECTORY)
+  set(_vtk_wrl_dir "${_vtk_rc_sdk}/Include/${_vtk_rc_ver}/winrt")
+  if (NOT EXISTS "${_vtk_wrl_dir}/wrl/client.h")
+    message(FATAL_ERROR "Registered Windows SDK WRL header missing: ${_vtk_wrl_dir}/wrl/client.h")
+  endif ()
+  vtk_module_include(VTK::RenderingOpenGL2 PRIVATE "${_vtk_wrl_dir}")
+  unset(_vtk_rc_arch)
+  unset(_vtk_rc_ver_dir)
+  unset(_vtk_rc_ver)
+  unset(_vtk_rc_bin)
+  unset(_vtk_rc_sdk)
+  unset(_vtk_wrl_dir)
+endif ()
 
