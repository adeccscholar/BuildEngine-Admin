+            dllResult = dxcSupport.initialize();
+          }
+        } else {
+          dllResult = dxcSupport.initialize();
+        }
+#else
+        dllResult = dxcSupport.initialize();
+#endif
+      }
+
+      if (DXC_FAILED(dllResult)) {
+        switch (dxcSupport.getFailureReason()) {
