# Stage exactly the monolithic DLL built by the installed Abseil package.
cmake_minimum_required(VERSION 3.25)
foreach(_name ABSEIL_PACKAGE_ROOT PDFIUM_PACKAGE_ROOT BUILD_CONFIGURATION)
  if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "Missing required parameter: ${_name}")
  endif()
endforeach()
set(_libdir "${ABSEIL_PACKAGE_ROOT}/lib/win64/${BUILD_CONFIGURATION}")
set(_bindir "${ABSEIL_PACKAGE_ROOT}/bin/win64/${BUILD_CONFIGURATION}")
set(_imports)
foreach(_name abseil_dll.lib libabseil_dll.lib abseil_dll.dll.a libabseil_dll.dll.a)
  if(EXISTS "${_libdir}/${_name}")
    list(APPEND _imports "${_libdir}/${_name}")
  endif()
endforeach()
list(LENGTH _imports _n)
if(NOT _n EQUAL 1)
  message(FATAL_ERROR "Expected exactly one installed Abseil import library in ${_libdir}, found ${_n}: ${_imports}")
endif()
set(_dlls)
foreach(_name abseil_dll.dll libabseil_dll.dll)
  if(EXISTS "${_bindir}/${_name}")
    list(APPEND _dlls "${_bindir}/${_name}")
  endif()
endforeach()
list(LENGTH _dlls _n)
if(NOT _n EQUAL 1)
  message(FATAL_ERROR "Expected exactly one installed Abseil DLL in ${_bindir}, found ${_n}: ${_dlls}")
endif()
list(GET _dlls 0 _src)
get_filename_component(_filename "${_src}" NAME)
set(_target "${PDFIUM_PACKAGE_ROOT}/bin/win64/${BUILD_CONFIGURATION}")
file(MAKE_DIRECTORY "${_target}")
file(COPY_FILE "${_src}" "${_target}/${_filename}" ONLY_IF_DIFFERENT)
message(STATUS "[ABSEIL] import=${_imports} DLL=${_src} staged=${_target}/${_filename}")
