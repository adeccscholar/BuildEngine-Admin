# BuildEngine PDFium bridge to the installed Skia 144 shared package.
# This file replaces PDFium's //skia/BUILD.gn and its private Chromium Skia
# source sets. The installation supplies both headers and import library.
_skia_include = getenv("CB_PDFIUM_SKIA_INCLUDE")
_skia_library = getenv("CB_PDFIUM_SKIA_LIB")
assert(_skia_include != "" && _skia_library != "",
       "Skia 144 installed include root and import library are required")

# Skia 144 is built as a CPU-only DLL (Ganesh, GL, Direct3D and PDF off).
# SKIA_DLL is the only required shared-library consumer definition here.
# Do not inject Skia 153's feature defines or compile Skia implementation sources.
config("skia_config") {
  include_dirs = [ _skia_include ]
  libs = [ _skia_library ]
  defines = [ "SKIA_DLL" ]
}

group("skia") {
  public_configs = [ ":skia_config" ]
}

# Compatibility targets used by PDFium/Chromium GN dependencies; no sources.
group("skia_core_and_effects") {
  public_deps = [ ":skia" ]
}
group("skia_opts") {
  public_deps = [ ":skia" ]
}
group("skcms") {
  public_deps = [ ":skia" ]
}
