# BuildEngine PDFium bridge to the installed Skia 153 shared package.
# This file replaces PDFium's //skia/BUILD.gn and its private Chromium Skia
# source sets. The installation supplies both headers and import library.
_skia_include = getenv("CB_PDFIUM_SKIA_INCLUDE")
_skia_library = getenv("CB_PDFIUM_SKIA_LIB")
assert(_skia_include != "" && _skia_library != "",
       "Skia 153 installed include root and import library are required")

# Match INTERFACE_COMPILE_DEFINITIONS in the installed SkiaConfig.cmake.
# Do not compile Skia implementation sources or use SkPdfiumUserConfig.h.
config("skia_config") {
  include_dirs = [ _skia_include ]
  libs = [ _skia_library ]
  defines = [
    "SKIA_DLL",
    "SK_GANESH",
    "SK_GL",
    "SK_DIRECT3D",
    "SK_SUPPORT_PDF",
    "SK_CODEC_DECODES_PNG",
    "SK_CODEC_DECODES_PNG_WITH_LIBPNG",
    "SK_CODEC_ENCODES_PNG",
    "SK_CODEC_ENCODES_PNG_WITH_LIBPNG",
    "SK_CODEC_DECODES_JPEG",
    "SK_CODEC_ENCODES_JPEG",
    "SK_CODEC_DECODES_WEBP",
    "SK_CODEC_ENCODES_WEBP",
    "SK_TYPEFACE_FACTORY_DIRECTWRITE",
    "SK_FONTMGR_DIRECTWRITE_AVAILABLE",
    "SK_FONTMGR_GDI_AVAILABLE",
  ]
}

group("skia") {
  public_configs = [ ":skia_config" ]
}

# Compatibility targets used by PDFium/Chromium GN dependencies; no sources.
group("skia_core_and_effects") {
  public_deps = [ ":skia" ]
}
group("skia_opts") {
  public_deps = [ ":skia" ]
}
group("skcms") {
  public_deps = [ ":skia" ]
}
