diff --git a/absl/strings/internal/charconv_bigint.h b/absl/strings/internal/charconv_bigint.h
--- a/absl/strings/internal/charconv_bigint.h
+++ b/absl/strings/internal/charconv_bigint.h
@@ -37,3 +37,11 @@
-ABSL_DLL extern const uint32_t
-    kFiveToNth[kMaxSmallPowerOfFive + 1];
-ABSL_DLL extern const uint32_t kTenToNth[kMaxSmallPowerOfTen + 1];
+// No externally linked lookup-table symbols under BCC64X.
+constexpr uint32_t SmallPowerOfFive(int n) {
+  uint32_t value = 1;
+  for (int i = 0; i < n; ++i) value *= 5;
+  return value;
+}
+constexpr uint32_t SmallPowerOfTen(int n) {
+  uint32_t value = 1;
+  for (int i = 0; i < n; ++i) value *= 10;
+  return value;
+}
@@ -176,1 +184,1 @@
-kFiveToNth[kMaxSmallPowerOfFive]
+SmallPowerOfFive(kMaxSmallPowerOfFive)
@@ -180,1 +188,1 @@
-kFiveToNth[n]
+SmallPowerOfFive(n)
@@ -194,1 +202,1 @@
-kTenToNth[n]
+SmallPowerOfTen(n)
