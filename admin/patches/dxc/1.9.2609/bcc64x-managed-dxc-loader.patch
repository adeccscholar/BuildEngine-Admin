+      else {
+#ifdef _WIN32
+        // Resolve the managed runtime next to dxc.exe, not via the host PATH.
+        char szExePath[32768]{};
+        DWORD dwLength = GetModuleFileNameA(nullptr, szExePath, sizeof(szExePath));
