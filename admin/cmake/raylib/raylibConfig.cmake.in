get_filename_component(_RAYLIB_LIBROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
get_filename_component(_RAYLIB_PKGROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
if(NOT TARGET raylib)
  add_library(raylib SHARED IMPORTED)
  set_target_properties(raylib PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_RAYLIB_PKGROOT}/include" INTERFACE_COMPILE_DEFINITIONS USE_LIBTYPE_SHARED IMPORTED_IMPLIB "${_RAYLIB_LIBROOT}/@_base@.lib" IMPORTED_LOCATION "${_RAYLIB_PKGROOT}/bin/win64/@CMAKE_BUILD_TYPE@/@_base@.dll")
endif()
set(raylib_FOUND TRUE)
unset(_RAYLIB_LIBROOT)
unset(_RAYLIB_PKGROOT)
