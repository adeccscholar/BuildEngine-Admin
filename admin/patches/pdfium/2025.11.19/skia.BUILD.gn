# BuildEngine PDFium adapter: installed Skia 153 shared package only.
# Both headers and import libraries come from the same configured package.
_skia_include = getenv("CB_PDFIUM_SKIA_INCLUDE")
_skia_library = getenv("CB_PDFIUM_SKIA_LIB")
assert(_skia_include != "" && _skia_library != "",
       "Installed Skia 153 package include and import library are required")
config("installed_skia") {
  include_dirs = [ _skia_include ]
  libs = [ _skia_library ]
  defines = [ "SKIA_DLL", "SK_GANESH" ]
}
group("skia") {
  public_configs = [ ":installed_skia" ]
}
group("skia_core_and_effects") {
  public_deps = [ ":skia" ]
}
group("skia_opts") {
  public_deps = [ ":skia" ]
}
group("skcms") {
  public_deps = [ ":skia" ]
}
