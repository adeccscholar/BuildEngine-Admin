+ocv_option(OPENCV_DNN_MLAS "Build the vendored MLAS acceleration layer" ON)
 set(HAVE_MLAS 0)
 set(MLAS_EXTERNAL_OBJECTS "")
 # Reset status flags + arch booleans
@@ -509,7 +510,7 @@
            MLAS_HAS_ASM MLAS_HAS_POWER10 MLAS_HAS_RISCV64_RVV)
   unset(${_v} CACHE)
 endforeach()
-if(NOT EMSCRIPTEN)
+if(OPENCV_DNN_MLAS AND NOT EMSCRIPTEN)
   add_subdirectory("${OpenCV_SOURCE_DIR}/3rdparty/mlas" "${CMAKE_BINARY_DIR}/3rdparty/mlas")
 endif()
 if(HAVE_MLAS)
