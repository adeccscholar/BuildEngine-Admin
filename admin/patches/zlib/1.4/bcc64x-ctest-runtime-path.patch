@@ -1,16 +1,9 @@
-function(ZLIB_findTestEnv testName)
-    set(testEnv "PATH=")
-
-    if(MSVC OR MINGW)
-        set(separator "\\\;")
-    else()
-        set(separator ":")
-    endif()
-
-    string(APPEND testEnv "$<TARGET_FILE_DIR:ZLIB::ZLIB>${separator}")
-    string(APPEND testEnv "$ENV{PATH}")
-
-    set_tests_properties(${testName} PROPERTIES ENVIRONMENT "${testEnv}")
-endfunction()
+function(ZLIB_findTestEnv testName)
+    # CTest must resolve the DLL of the actual target under test.  In
+    # particular BCC64X is not MSVC or MinGW, and the inherited PATH alone
+    # does not necessarily contain the generated shared-library directory.
+    set_tests_properties(${testName} PROPERTIES ENVIRONMENT_MODIFICATION
+        "PATH=path_list_prepend:$<TARGET_FILE_DIR:ZLIB::ZLIB>")
+endfunction()
 
