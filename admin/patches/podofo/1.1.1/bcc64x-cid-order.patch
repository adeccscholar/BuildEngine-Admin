+        if (m_DynamicCIDMap != nullptr)
+        {
+            // Create a cid/gid map from the dynamic mapping. The backing
+            // container is unordered, so sort by character code to keep
+            // exported PDF structures deterministic across STL implementations.
+            vector<pair<PdfCharCode, unsigned>> mappings;
+            mappings.reserve(m_DynamicCIDMap->GetMappings().size());
+            for (auto& pair : m_DynamicCIDMap->GetMappings())
+                mappings.push_back({ pair.first, *pair.second });
+
+            std::sort(mappings.begin(), mappings.end(),
+                [](auto const& lhs, auto const& rhs) { return lhs.first.Code < rhs.first.Code; });
+
+            ret.resize(mappings.size());
+            unsigned i = 0;
+            for (auto& pair : mappings)
+            {
+                ret[i] = { pair.second, pair.second, PdfGID(pair.second) };
+                i++;
+            }
+            return ret;
+        }
 
