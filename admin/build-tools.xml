<?xml version="1.0" encoding="utf-8"?>
<buildTools xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="schemas/build-tools.xsd"
            schemaVersion="4">
   <tool id="git" version="2.55.0.3" runtimeVersion="2.55.0.windows.3" required="always">
      <managed root="git\2.55.0.3" executable="cmd\git.exe">
         <download url="https://github.com/git-for-windows/git/releases/download/v2.55.0.windows.3/MinGit-2.55.0.3-64-bit.zip"
                   archive="MinGit-2.55.0.3-64-bit.zip"
                   sha256="f48e2d2dc74a24454adc6d8fd0ac25bf9c2386f19cfb06202b9465aaad4f9f05"/>
      </managed>
      <probe contains="git version 2.55.0.windows.3">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="cmake" version="4.1.1" required="always">
      <discover executable="cmake.exe" path="false">
         <candidate path="{USERPROFILE}\Documents\Embarcadero\Studio\37.0\CatalogRepository\CMake-cb\4.1.1\bin\cmake.exe"/>
      </discover>
      <probe contains="cmake version 4.1.1">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="ninja" version="1.13.2" required="always">
      <managed root="ninja\1.13.2" executable="ninja.exe">
         <download url="https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-win.zip"
                   archive="ninja-1.13.2.zip"
                   sha256="07fc8261b42b20e71d1720b39068c2e14ffcee6396b76fb7a795fb460b78dc65"/>
      </managed>
      <probe contains="1.13.2">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="perl" version="5.42.2.1" runtimeVersion="5.42.2" required="always">
      <managed root="perl\5.42.2.1" executable="perl\bin\perl.exe">
         <download url="https://github.com/StrawberryPerl/Perl-Dist-Strawberry/releases/download/SP_54221_64bit/strawberry-perl-5.42.2.1-64bit-portable.zip"
                   archive="strawberry-perl-5.42.2.1-64bit-portable.zip"
                   sha256="32d83be90cf04b807cfb9477482bc36302cdee6f5b04cf57e81adecbd8f07898"/>
      </managed>
      <probe contains="v5.42.2">
         <argument value="-e"/>
         <argument value="print $^V"/>
      </probe>
   </tool>

   <tool id="python" version="3.14.7" required="always">
      <managed root="python\3.14.7-build" executable="python.exe">
         <download url="https://www.python.org/ftp/python/3.14.7/python-3.14.7-embed-amd64.zip"
                   archive="python-3.14.7-embed-amd64.zip"
                   sha256="d297e5ff019966817ad8502465176139f2d3d840fa4ed84b13bed399a6ab1f15"/>
         <extract executable="{ENV:SystemRoot}\System32\WindowsPowerShell\v1.0\powershell.exe">
            <argument value="-NoProfile"/>
            <argument value="-NonInteractive"/>
            <argument value="-ExecutionPolicy"/>
            <argument value="Bypass"/>
            <argument value="-File"/>
            <argument value="{ProductionRoot}\admin\programs\python\extract-build-python.ps1"/>
            <argument value="{Archive}"/>
            <argument value="{ManagedRoot}"/>
            <argument value="{ProductionRoot}\admin\programs\python\python314._pth"/>
            <argument value="{ProductionRoot}\admin\programs\python\sitecustomize.py"/>
         </extract>
      </managed>
      <probe contains="Python 3.14.7">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="meson" version="1.12.0" required="always">
      <managed root="meson\1.12.0" executable="meson.py">
         <download url="https://files.pythonhosted.org/packages/source/m/meson/meson-1.12.0.tar.gz"
                   archive="meson-1.12.0.tar.gz"
                   sha256="88afe0c20e52030218924ac37d0c81c59b4b5f3ae3752c8c6d7470c7d365886c"/>
         <nativeExtract format="libarchive" root="meson-1.12.0">
            <require path="meson.py"/>
            <require path="mesonbuild\mesonmain.py"/>
            <require path="COPYING"/>
         </nativeExtract>
      </managed>
      <launcher tool="python">
         <argument value="{ToolEntry}"/>
      </launcher>
      <probe contains="1.12.0">
         <argument value="--version"/>
      </probe>
   </tool>

   <!-- Mesa's native Windows Meson path explicitly prefers win_flex/win_bison. -->
   <tool id="winflexbison" version="2.5.25" required="always">
      <managed root="winflexbison\2.5.25" executable="win_flex.exe">
         <download url="https://github.com/lexxmark/winflexbison/releases/download/v2.5.25/win_flex_bison-2.5.25.zip"
                   archive="win_flex_bison-2.5.25.zip"
                   sha256="8d324b62be33604b2c45ad1dd34ab93d722534448f55a16ca7292de32b6ac135"/>
      </managed>
      <probe contains="2.6.4">
         <argument value="--version"/>
      </probe>
   </tool>

   <!-- Mesa documents pkg-config as a Windows build prerequisite. -->
   <tool id="pkg-config" version="0.28-1" runtimeVersion="0.28" required="always">
      <managed root="pkg-config-lite\0.28-1" executable="pkg-config-lite-0.28-1\bin\pkg-config.exe">
         <download url="https://sourceforge.net/projects/pkgconfiglite/files/0.28-1/pkg-config-lite-0.28-1_bin-win32.zip/download"
                   archive="pkg-config-lite-0.28-1_bin-win32.zip"
                   sha256="2038c49d23b5ca19e2218ca89f06df18fe6d870b4c6b54c0498548ef88771f6f"/>
      </managed>
      <probe contains="0.28">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="doxygen" version="1.18.0" required="always">
      <managed root="doxygen\1.18.0" executable="doxygen.exe">
         <download url="https://github.com/doxygen/doxygen/releases/download/Release_1_18_0/doxygen-1.18.0.windows.x64.bin.zip"
                   archive="doxygen-1.18.0.windows.x64.bin.zip"
                   sha256="e84f54cfd49ef06b0b16536056dbec0c496323de28abcce53a4269463de35eaf"/>
      </managed>
      <probe contains="1.18.0">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="bcc64x" version="20.1.7" required="always">
      <bds executable="bin64\bcc64x.exe"/>
   </tool>

   <tool id="embarcadero-make" version="5.43" required="always">
      <bds executable="bin\make.exe"/>
   </tool>

   <tool id="llvm-ar" version="20.1.7" required="always">
      <bds executable="bin64\llvm-ar.exe"/>
   </tool>

   <tool id="llvm-ranlib" version="20.1.7" required="always">
      <bds executable="bin64\llvm-ranlib.exe"/>
   </tool>

   <tool id="ld-lld" version="20.1.7" required="always">
      <bds executable="bin64\ld.lld.exe"/>
   </tool>

   <tool id="bcc64x-windres" version="20.1.7" required="always">
      <bds executable="bin64\bcc64x-windres.exe"/>
   </tool>

   <tool id="tdump" version="RADStudio-13" required="always">
      <discover executable="tdump.exe" path="false">
         <candidate path="{BDS}\bin64\tdump.exe"/>
         <candidate path="{BDS}\bin\tdump.exe"/>
      </discover>
   </tool>

   <tool id="llvm-cov" version="20.1.7" required="always">
      <managed root="llvm\20.1.7" executable="bin\llvm-cov.exe">
         <download url="https://github.com/llvm/llvm-project/releases/download/llvmorg-20.1.7/clang%2Bllvm-20.1.7-x86_64-pc-windows-msvc.tar.xz"
                   archive="clang+llvm-20.1.7-x86_64-pc-windows-msvc.tar.xz"
                   sha256="34a66bb4891584b32d32bbe5f129e345899b255593dab2c359b730b92e304b3e"/>
         <nativeExtract format="libarchive" root="clang+llvm-20.1.7-x86_64-pc-windows-msvc">
            <include path="bin/llvm-cov.exe"/>
            <include path="bin/*.dll"/>
            <include path="LICENSE.TXT"/>
            <require path="bin/llvm-cov.exe"/>
         </nativeExtract>
      </managed>
      <probe contains="LLVM version 20.1.7">
         <argument value="--version"/>
      </probe>
   </tool>

   <tool id="windows-rc" version="Windows-SDK" required="always">
      <discover executable="rc.exe" path="true">
         <candidate path="{ProgramFilesX86}\Windows Kits\10\bin\*\x64\rc.exe"/>
      </discover>
   </tool>

   <tool id="nasm" version="3.02" required="always">
      <managed root="nasm\3.02" executable="nasm-3.02\nasm.exe">
         <download
            url="https://www.nasm.us/pub/nasm/releasebuilds/3.02/win64/nasm-3.02-win64.zip"
            archive="nasm-3.02-win64.zip"
            sha256="161d0bfaff53c2f9e9f3e69fd0672323ebabafd1268976a5cec11be92a19aee7"/>
      </managed>
      <probe contains="NASM version 3.02">
         <argument value="-v"/>
      </probe>
   </tool>
</buildTools>
