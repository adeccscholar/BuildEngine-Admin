<?xml version="1.0" encoding="utf-8"?>
<smokeTests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="schemas/smoke-tests.xsd"
            schemaVersion="3">
   <library id="pugixml">
      <smoke id="installed-consumer-charconv" source="pugixml\installed-consumer-charconv" enabled="true" minVersion="1.16">
         <description value="Consume the installed CMake package with BCC64X and verify the floating-point charconv path."/>
         <environment name="CB_BCC64X" value="{Tool:bcc64x}"/>
         <environment name="CB_BDS" value="{BDS}"/>
         <environment name="PATH"
                      value="{InstallRoot}\packages\{LibraryId}\{LibraryVersion}\bin\win64\{Configuration};{ENV:PATH}"/>
         <argument value="-G"/>
         <argument value="Ninja"/>
         <argument value="-DCMAKE_TOOLCHAIN_FILE:FILEPATH={ProductionRoot}\admin\cmake\toolchains\bcc64x-buildengine-cxx.cmake"/>
         <argument value="-DCMAKE_MAKE_PROGRAM:FILEPATH={Tool:ninja}"/>
         <argument value="-Dpugixml_DIR:PATH={InstallRoot}\packages\{LibraryId}\{LibraryVersion}\lib\win64\{Configuration}\cmake\pugixml"/>
         <cmake mode="configure" executable="{Tool:cmake}"
                source="{SmokeRoot}\{SmokeSource}" build="{Workspace}"/>
         <cmake mode="build" executable="{Tool:cmake}" build="{Workspace}"/>
         <execute executable="{Workspace}\pugixml-installed-consumer-charconv.exe"/>
         <variant name="Release">
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Release"/>
            <argument value="-DCMAKE_CXX_FLAGS_RELEASE:STRING=-O2 -DNDEBUG"/>
         </variant>
         <variant name="Debug">
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Debug"/>
            <argument value="-DCMAKE_CXX_FLAGS_DEBUG:STRING=-O0"/>
         </variant>
         <expectation kind="compile-definition" value="PUGIXML_CHARCONV_FLOAT"/>
         <expectation kind="package-target" value="pugixml::pugixml"/>
         <expectation kind="behavior" value="double-roundtrip"/>
      </smoke>
   </library>

   <library id="curl">
      <smoke id="installed-consumer-runtime" source="curl\installed-consumer-runtime" enabled="true" minVersion="8.21.0">
         <description value="Consume the installed CURL CMake package with BCC64X and verify the declared runtime feature contract without network access."/>
         <environment name="CB_BCC64X" value="{Tool:bcc64x}"/>
         <environment name="CB_BDS" value="{BDS}"/>
         <environment name="PATH"
                      value="{InstallRoot}\packages\curl\8.21.0\bin\win64\{Configuration};{InstallRoot}\packages\openssl\3.5.8\bin\win64\{Configuration};{InstallRoot}\packages\zlib\1.3.2\bin\win64\{Configuration};{InstallRoot}\packages\brotli\1.2.0\bin\win64\{Configuration};{InstallRoot}\packages\zstd\1.5.7\bin\win64\{Configuration};{ENV:PATH}"/>
         <argument value="-G"/>
         <argument value="Ninja"/>
         <argument value="-DCMAKE_TOOLCHAIN_FILE:FILEPATH={ProductionRoot}\admin\cmake\toolchains\bcc64x-buildengine-cxx.cmake"/>
         <argument value="-DCMAKE_MAKE_PROGRAM:FILEPATH={Tool:ninja}"/>
         <argument value="-DCURL_DIR:PATH={InstallRoot}\packages\curl\8.21.0\lib\win64\{Configuration}\cmake\CURL"/>
         <argument value="-DOPENSSL_INCLUDE_DIR:PATH={InstallRoot}\packages\openssl\3.5.8\include"/>
         <argument value="-DOPENSSL_SSL_LIBRARY:FILEPATH={InstallRoot}\packages\openssl\3.5.8\lib\win64\{Configuration}\libssl.lib"/>
         <argument value="-DOPENSSL_CRYPTO_LIBRARY:FILEPATH={InstallRoot}\packages\openssl\3.5.8\lib\win64\{Configuration}\libcrypto.lib"/>
         <argument value="-DZLIB_INCLUDE_DIR:PATH={InstallRoot}\packages\zlib\1.3.2\include"/>
         <argument value="-DBROTLI_INCLUDE_DIR:PATH={InstallRoot}\packages\brotli\1.2.0\include"/>
         <argument value="-DBROTLIDEC_LIBRARY:FILEPATH={InstallRoot}\packages\brotli\1.2.0\lib\win64\{Configuration}\libbrotlidec.lib"/>
         <argument value="-DBROTLICOMMON_LIBRARY:FILEPATH={InstallRoot}\packages\brotli\1.2.0\lib\win64\{Configuration}\libbrotlicommon.lib"/>
         <argument value="-DZSTD_INCLUDE_DIR:PATH={InstallRoot}\packages\zstd\1.5.7\include"/>
         <argument value="-DZSTD_LIBRARY:FILEPATH={InstallRoot}\packages\zstd\1.5.7\lib\win64\{Configuration}\libzstd.lib"/>
         <cmake mode="configure" executable="{Tool:cmake}"
                source="{SmokeRoot}\{SmokeSource}" build="{Workspace}"/>
         <cmake mode="build" executable="{Tool:cmake}" build="{Workspace}"/>
         <execute executable="{Workspace}\curl-installed-consumer-runtime.exe"/>
         <variant name="Release">
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Release"/>
            <argument value="-DCMAKE_CXX_FLAGS_RELEASE:STRING=-O2 -DNDEBUG"/>
            <argument value="-DZLIB_LIBRARY:FILEPATH={InstallRoot}\packages\zlib\1.3.2\lib\win64\Release\libz.lib"/>
         </variant>
         <variant name="Debug">
            <argument value="-DCMAKE_BUILD_TYPE:STRING=Debug"/>
            <argument value="-DCMAKE_CXX_FLAGS_DEBUG:STRING=-O0"/>
            <argument value="-DZLIB_LIBRARY:FILEPATH={InstallRoot}\packages\zlib\1.3.2\lib\win64\Debug\libzd.lib"/>
         </variant>
         <expectation kind="package-target" value="CURL::libcurl"/>
         <expectation kind="protocol" value="http"/>
         <expectation kind="protocol" value="https"/>
         <expectation kind="protocol" value="ldap"/>
         <expectation kind="protocol" value="ldaps"/>
         <expectation kind="feature" value="OpenSSL"/>
         <expectation kind="feature" value="IPv6"/>
         <expectation kind="feature" value="AsynchDNS"/>
         <expectation kind="feature" value="IDN"/>
         <expectation kind="feature" value="SSPI"/>
         <expectation kind="feature" value="NTLM"/>
         <expectation kind="feature" value="libz"/>
         <expectation kind="feature" value="brotli"/>
         <expectation kind="feature" value="zstd"/>
         <expectation kind="feature" value="Unicode"/>
         <expectation kind="feature" value="NativeCA"/>
      </smoke>
   </library>
</smokeTests>
