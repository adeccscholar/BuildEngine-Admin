--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,6 +15,29 @@
 set(CPPWINRT_BUILD_VERSION "999.999.999.999" CACHE STRING "The version string used for cppwinrt.")
 if(CPPWINRT_BUILD_VERSION STREQUAL "999.999.999.999" OR CPPWINRT_BUILD_VERSION STREQUAL "0.0.0.0")
     message(WARNING "CPPWINRT_BUILD_VERSION has been set to a dummy version string. Do not use in production!")
 endif()
+if(CMAKE_CXX_SIMULATE_ID STREQUAL "EMBT" AND WIN32)
+    if(NOT DEFINED ENV{CB_WINDOWS_RC} OR "$ENV{CB_WINDOWS_RC}" STREQUAL "")
+        message(FATAL_ERROR "Registered Windows SDK RC is required for C++/WinRT tests")
+    endif()
+    get_filename_component(_rcbin "$ENV{CB_WINDOWS_RC}" DIRECTORY)
+    get_filename_component(_rcversiondir "${_rcbin}" DIRECTORY)
+    get_filename_component(_rcversion "${_rcversiondir}" NAME)
+    get_filename_component(_rcbinroot "${_rcversiondir}" DIRECTORY)
+    get_filename_component(_sdkroot "${_rcbinroot}" DIRECTORY)
+    set(_incroot "${_sdkroot}/Include/${_rcversion}")
+    if(NOT EXISTS "${_incroot}/um/winstring.h")
+        message(FATAL_ERROR "Registered Windows SDK missing um/winstring.h: ${_incroot}")
+    endif()
+    include_directories(BEFORE "${_incroot}/um" "${_incroot}/shared" "${_incroot}/winrt")
+    message(STATUS "C++/WinRT Windows SDK headers: ${_incroot}")
+endif()
 message(STATUS "Using version string: ${CPPWINRT_BUILD_VERSION}")
