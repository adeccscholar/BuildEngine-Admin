diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -190,6 +190,10 @@
 #
 # CMake 3.27 doesn't have CMAKE_RC_COMPILER_ID so we rely on
 # CMAKE_C_COMPILER_ID.
+# BuildEngine uses the Windows SDK rc.exe for native BCC64X builds.
+# In particular, do not infer GNU windres from the Clang/EMBT C compiler:
+# rc.exe does not accept --use-temp-file or GNU package-name escaping.
+# Keep the upstream GNU-only condition below intact.
 if((MINGW OR CYGWIN) AND (
         NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR
         CMAKE_C_COMPILER_VERSION VERSION_GREATER_EQUAL "17"))
