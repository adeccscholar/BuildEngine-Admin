+file(GLOB SOURCE_FILES RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} "[^.]*.h" "[^.]*.cpp")
+source_group("" FILES ${SOURCE_FILES})
+
+# White-box tests need the internal archives. Keep XMP tests isolated when
+# building a shared PoDoFo library, so they use DLL public exports only.
+if(PODOFO_BUILD_SHARED)
+    list(REMOVE_ITEM SOURCE_FILES XMPTest.cpp)
+endif()
+
+include_directories(
+    ${Fontconfig_INCLUDE_DIRS}
+    ${FREETYPE_INCLUDE_DIRS}
+    ${CMAKE_CURRENT_BINARY_DIR}
+)
+
+# repeat for each test
+add_executable(podofo-unit ${SOURCE_FILES})
+target_link_libraries(podofo-unit
+    podofo_test
+    OpenSSL::Crypto
+    ${PODOFO_LIBRARIES}
+    podofo_private
+    podofo_3rdparty
+)
+add_compile_options(${PODOFO_CFLAGS})
+
+include(CTest)
+include(Catch)
+catch_discover_tests(podofo-unit)
+
+if(PODOFO_BUILD_SHARED)
+    add_executable(podofo-xmp-dll-tests main.cpp XMPTest.cpp)
+    target_link_libraries(podofo-xmp-dll-tests PRIVATE
+        podofo_test
+        podofo_shared
+    )
+    catch_discover_tests(podofo-xmp-dll-tests)
+endif()
