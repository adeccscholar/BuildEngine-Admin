<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
   <xs:complexType name="securityRepositoryType">
      <xs:attribute name="url" type="xs:anyURI" use="required"/>
      <xs:attribute name="ref" type="xs:string" use="optional"/>
      <xs:attribute name="commit" type="xs:string" use="optional"/>
   </xs:complexType>

   <xs:element name="securityIdentities">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="library" minOccurs="1" maxOccurs="unbounded">
               <xs:complexType>
                  <xs:sequence>
                     <xs:element name="repository" type="securityRepositoryType"/>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:string" use="required"/>
                  <xs:attribute name="version" type="xs:string" use="required"/>
               </xs:complexType>
            </xs:element>
         </xs:sequence>
         <xs:attribute name="schemaVersion" use="required" fixed="1"/>
      </xs:complexType>
      <xs:unique name="uniqueSecurityLibraryVersion">
         <xs:selector xpath="library"/>
         <xs:field xpath="@id"/>
         <xs:field xpath="@version"/>
      </xs:unique>
   </xs:element>
</xs:schema>
