# One selected version per package. No PATH or newest-version discovery.
if(NOT DEFINED ADECC_RUNTIME_ROOTS_FILE OR
   NOT DEFINED ADECC_RUNTIME_CONFIGURATION OR
   NOT DEFINED ADECC_RUNTIME_OUTPUT_DIR)
   message(FATAL_ERROR "BuildEngine runtime staging requires a roots file, configuration and output directory")
endif()
if(NOT EXISTS "${ADECC_RUNTIME_ROOTS_FILE}")
   message(FATAL_ERROR "Runtime package roots manifest is missing: ${ADECC_RUNTIME_ROOTS_FILE}")
endif()
file(STRINGS "${ADECC_RUNTIME_ROOTS_FILE}" vecRoots ENCODING UTF-8)
if(NOT vecRoots)
   message(FATAL_ERROR "Runtime package roots manifest is empty: ${ADECC_RUNTIME_ROOTS_FILE}")
endif()
if(NOT ADECC_RUNTIME_CONFIGURATION MATCHES "^(Debug|Release)$")
   message(FATAL_ERROR "Unsupported runtime variant: ${ADECC_RUNTIME_CONFIGURATION}")
endif()
if(NOT IS_DIRECTORY "${ADECC_RUNTIME_OUTPUT_DIR}")
   message(FATAL_ERROR "Runtime output directory missing: ${ADECC_RUNTIME_OUTPUT_DIR}")
endif()

# A consumer can declare exact retired DLL basenames. This list only affects
# its own output folder; source packages and unrelated consumers are unchanged.
set(vecExcludedDlls)
if(DEFINED ADECC_RUNTIME_EXCLUDED_DLLS_FILE AND
   NOT "${ADECC_RUNTIME_EXCLUDED_DLLS_FILE}" STREQUAL "")
   if(NOT EXISTS "${ADECC_RUNTIME_EXCLUDED_DLLS_FILE}")
      message(FATAL_ERROR "Excluded DLL manifest missing: ${ADECC_RUNTIME_EXCLUDED_DLLS_FILE}")
   endif()
   file(STRINGS "${ADECC_RUNTIME_EXCLUDED_DLLS_FILE}"
      vecExcludedNames ENCODING UTF-8)
   foreach(strName IN LISTS vecExcludedNames)
      if(NOT strName MATCHES "^[A-Za-z0-9_+.-]+[.]dll$")
         message(FATAL_ERROR "Invalid excluded DLL basename: ${strName}")
      endif()
      string(TOLOWER "${strName}" strKey)
      list(APPEND vecExcludedDlls "${strKey}")
   endforeach()
   list(REMOVE_DUPLICATES vecExcludedDlls)
endif()

# An incremental build may already contain obsolete DLLs copied by earlier
# staging runs. Remove only exact excluded names from the declared app output.
if(vecExcludedDlls)
   file(GLOB vecExisting LIST_DIRECTORIES FALSE "${ADECC_RUNTIME_OUTPUT_DIR}/*")
   foreach(theExisting IN LISTS vecExisting)
      get_filename_component(strExistingName "${theExisting}" NAME)
      string(TOLOWER "${strExistingName}" strExistingKey)
      list(FIND vecExcludedDlls "${strExistingKey}" iExcluded)
      if(iExcluded GREATER_EQUAL 0)
         file(REMOVE "${theExisting}")
         if(EXISTS "${theExisting}")
            message(FATAL_ERROR "Could not purge retired runtime DLL: ${theExisting}")
         endif()
         message(STATUS "[RUNTIME] removed retired DLL from consumer output: ${strExistingName}")
      endif()
   endforeach()
endif()

set(vecNames)
set(vecSources)
set(uStaged 0)
function(_adecc_stage_dll theFile)
   get_filename_component(strName "${theFile}" NAME)
   string(TOLOWER "${strName}" strKey)
   if(NOT strKey MATCHES "[.]dll$")
      return()
   endif()
   list(FIND vecExcludedDlls "${strKey}" iExcluded)
   if(iExcluded GREATER_EQUAL 0)
      message(STATUS "[RUNTIME] retired DLL not deployed: ${strName}; source=${theFile}")
      return()
   endif()
   # PE32+ AMD64 check detects wrong-bitness/invalid DLLs before running.
   file(SIZE "${theFile}" uSize)
   if(uSize LESS 70)
      message(FATAL_ERROR "Runtime DLL too small: ${theFile}")
   endif()
   file(READ "${theFile}" strMz OFFSET 0 LIMIT 2 HEX)
   file(READ "${theFile}" strOffset OFFSET 60 LIMIT 4 HEX)
   string(LENGTH "${strOffset}" uOffsetHexLength)
   if(NOT strMz STREQUAL "4d5a" OR NOT uOffsetHexLength EQUAL 8 OR
      NOT strOffset MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Runtime DLL is not a PE image: ${theFile}")
   endif()
   string(SUBSTRING "${strOffset}" 0 2 b0)
   string(SUBSTRING "${strOffset}" 2 2 b1)
   string(SUBSTRING "${strOffset}" 4 2 b2)
   string(SUBSTRING "${strOffset}" 6 2 b3)
   math(EXPR uOffset "0x${b3}${b2}${b1}${b0}")
   math(EXPR uMin "${uOffset} + 6")
   if(uMin GREATER uSize)
      message(FATAL_ERROR "Truncated runtime PE header: ${theFile}")
   endif()
   file(READ "${theFile}" strHeader OFFSET ${uOffset} LIMIT 6 HEX)
   if(NOT strHeader STREQUAL "504500006486")
      message(FATAL_ERROR "Runtime DLL is not PE/COFF x64: ${theFile}; header=${strHeader}")
   endif()

   list(FIND vecNames "${strKey}" iSeen)
   if(iSeen GREATER_EQUAL 0)
      list(GET vecSources ${iSeen} theOldFile)
      file(SHA256 "${theOldFile}" hash1)
      file(SHA256 "${theFile}" hash2)
      if(NOT hash1 STREQUAL hash2)
         message(FATAL_ERROR "DLL name collision '${strName}': ${theOldFile} versus ${theFile}")
      endif()
      return()
   endif()
   set(theDest "${ADECC_RUNTIME_OUTPUT_DIR}/${strName}")
   if(EXISTS "${theDest}")
      file(SHA256 "${theDest}" hash1)
      file(SHA256 "${theFile}" hash2)
      if(NOT hash1 STREQUAL hash2)
         message(FATAL_ERROR "Application DLL conflicts with package DLL: ${theDest} versus ${theFile}")
      endif()
   else()
      file(COPY_FILE "${theFile}" "${theDest}" ONLY_IF_DIFFERENT)
   endif()
   file(SHA256 "${theFile}" strFileHash)
   message(STATUS "[RUNTIME] ${strName} SHA256=${strFileHash} source=${theFile}")
   list(APPEND vecNames "${strKey}")
   list(APPEND vecSources "${theFile}")
   math(EXPR uStaged "${uStaged} + 1")
   set(vecNames "${vecNames}" PARENT_SCOPE)
   set(vecSources "${vecSources}" PARENT_SCOPE)
   set(uStaged "${uStaged}" PARENT_SCOPE)
endfunction()

# Toolchain runtime search is fixed to the selected BCC64X installation.
# Copy only explicitly declared runtime DLLs, with identical PE/hash checks.
if(DEFINED ADECC_RUNTIME_TOOLCHAIN_DLLS_FILE)
   if(NOT EXISTS "${ADECC_RUNTIME_TOOLCHAIN_DLLS_FILE}")
      message(FATAL_ERROR "Runtime toolchain manifest absent: ${ADECC_RUNTIME_TOOLCHAIN_DLLS_FILE}")
   endif()
   file(STRINGS "${ADECC_RUNTIME_TOOLCHAIN_DLLS_FILE}" vecToolchainDlls ENCODING UTF-8)
   if(vecToolchainDlls)
      if(NOT DEFINED ADECC_RUNTIME_TOOLCHAIN_BIN OR
         NOT IS_DIRECTORY "${ADECC_RUNTIME_TOOLCHAIN_BIN}")
         message(FATAL_ERROR "Selected BCC64X runtime requires toolchain bin64")
      endif()
      foreach(strDll IN LISTS vecToolchainDlls)
         if(NOT strDll MATCHES "^[A-Za-z0-9_+.-]+[.]dll$")
            message(FATAL_ERROR "Invalid BCC64X runtime DLL name: ${strDll}")
         endif()
         set(theRuntime "${ADECC_RUNTIME_TOOLCHAIN_BIN}/${strDll}")
         if(NOT EXISTS "${theRuntime}")
            message(FATAL_ERROR "Declared BCC64X runtime is missing: ${theRuntime}")
         endif()
         _adecc_stage_dll("${theRuntime}")
      endforeach()
   endif()
endif()

foreach(theRoot IN LISTS vecRoots)
   if(NOT IS_DIRECTORY "${theRoot}")
      message(FATAL_ERROR "Declared runtime package root is missing: ${theRoot}")
   endif()
   foreach(theBin IN ITEMS "${theRoot}/bin/win64/${ADECC_RUNTIME_CONFIGURATION}" "${theRoot}/bin")
      if(NOT IS_DIRECTORY "${theBin}")
         continue()
      endif()
      file(GLOB vecFiles LIST_DIRECTORIES FALSE "${theBin}/*")
      list(SORT vecFiles)
      foreach(theFile IN LISTS vecFiles)
         _adecc_stage_dll("${theFile}")
      endforeach()
   endforeach()
endforeach()
message(STATUS "BuildEngine runtime: ${uStaged} Windows x64 DLLs staged in ${ADECC_RUNTIME_OUTPUT_DIR}")
